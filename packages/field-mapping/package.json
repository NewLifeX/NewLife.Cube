{
  "name": "@newlifex/field-mapping",
  "version": "0.1.0",
  "description": "魔方前端字段映射模块，DataField 元数据到 UI 组件的映射规则引擎",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": ["魔方", "cube", "newlife", "field", "mapping", "datafield"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NewLifeX/NewLife.Cube.git"
  },
  "homepage": "https://github.com/NewLifeX/NewLife.Cube",
  "bugs": {
    "url": "https://github.com/NewLifeX/NewLife.Cube/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "prepare": "pnpm build",
    "pretest": "pnpm build",
    "test": "node --test \"tests/**/*.test.cjs\""
  },
  "dependencies": {
    "@newlifex/api-core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}