{
  "name": "@newlifex/cube",
  "version": "0.1.0",
  "description": "魔方（NewLife.Cube）前端公共逻辑：API 调用层、字段映射、认证与列表页业务编排，框架无关，附 Pinia/Zustand 适配器",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./pinia": {
      "types": "./dist/pinia.d.ts",
      "import": "./dist/pinia.js",
      "require": "./dist/pinia.cjs"
    },
    "./zustand": {
      "types": "./dist/zustand.d.ts",
      "import": "./dist/zustand.js",
      "require": "./dist/zustand.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "魔方",
    "cube",
    "newlife",
    "api",
    "token",
    "datafield",
    "auth",
    "crud"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NewLifeX/NewLife.Cube.git"
  },
  "homepage": "https://github.com/NewLifeX/NewLife.Cube",
  "bugs": {
    "url": "https://github.com/NewLifeX/NewLife.Cube/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/pinia.ts src/zustand.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts src/pinia.ts src/zustand.ts --format esm,cjs --dts --watch",
    "prepare": "pnpm build",
    "pretest": "tsup src/index.ts src/pinia.ts src/zustand.ts --format esm,cjs --dts",
    "test": "node --test \"tests/**/*.test.cjs\""
  },
  "dependencies": {
    "axios": "^1.20.0",
    "qs": "^6.16.0"
  },
  "peerDependencies": {
    "pinia": ">=2.0.0",
    "vue": ">=3.0.0",
    "zustand": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "pinia": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "zustand": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/qs": "^6.9.0",
    "pinia": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "5.7.3",
    "vue": "^3.5.33",
    "zustand": "^5.0.0"
  },
  "license": "MIT"
}
