<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyTitle>魔方Swagger接口文档</AssemblyTitle>
    <Description>魔方Swagger接口文档扩展包，支持按区域(Area)自动分组生成API文档。提供标准化的接口描述、请求响应模型展示、在线调试功能，便于前后端对接和第三方集成。</Description>
    <Company>新生命开发团队</Company>
    <Copyright>©2002-2026 NewLife</Copyright>
    <VersionPrefix>6.16</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(VersionPrefix).*</AssemblyVersion>
    <Deterministic>false</Deterministic>
    <OutputPath>..\Bin3</OutputPath>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\Doc\newlife.snk</AssemblyOriginatorKeyFile>
    <NoWarn>1701;1702;NU5104;NETSDK1138;CS7035</NoWarn>
    <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
  </PropertyGroup>
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>NewLife.Cube.Swagger</PackageId>
    <Authors>$(Company)</Authors>
    <PackageProjectUrl>https://newlifex.com/cube</PackageProjectUrl>
    <PackageIcon>leaf.png</PackageIcon>
    <RepositoryUrl>https://github.com/NewLifeX/NewLife.Cube</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>新生命团队;X组件;NewLife;$(AssemblyName)</PackageTags>
    <PackageReleaseNotes>接入编译期词表并将运行时语言扩展到 31 种，API、MVC 视图与 Vue 前端全量本地化；API 标准端点收敛为 RESTful 子资源（meta、{id}、PUT、DELETE、charts/export/import/attachments），原 GetPage/GetFields 等端点下线；新增自描述 meta 与 page-logic 页面呈现配置，列表支持列宽对齐、树形、stat 汇总与批量启用禁用；CubeTable 组件与页面引擎落地，八个 SPA 皮肤补齐工作台真实数据、多标签页、卡片拖拽、窄屏抽屉与列表图表切换；安全防御内置威胁检测、自动封禁与可信代理学习，修复认证绕过、上传穿越、越权并加固 SSO；数据权限回归接口层，用户页非系统角色只读、部门按管理者过滤；新增账号注销扩展点、单设备登录踢旧设备与登录配置 v2；NativeAOT 冒烟 18 场景、多 OS 架构矩阵与 TFM 守门，升级 NewLife.Core 12.0、XCode 12.3、Remoting 4.0 等 2026-10-24 正式版依赖</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.1.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NewLife.Stardust.Extensions" Version="3.10.2026.1024" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.3" />
  </ItemGroup>
  <!-- .NET 内建 OpenAPI（AddOpenApi）：仅 net9.0+ 提供，且版本须与 .NET 及 Swashbuckle 的 Microsoft.OpenApi(2.x) 对齐；compile 资产随 ProjectReference 传递 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <!-- net9.0 必须用 9.0.x：10.x 源生成器依赖 Microsoft.OpenApi 2.x 的 IOpenApiOperationTransformer 等类型，net9.0 目标下编译失败 -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.21" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\Doc\leaf.png" Link="leaf.png" PackagePath="\" />
    <EmbeddedResource Include="Resources\scalar-config.js" LogicalName="NewLife.Cube.Swagger.Resources.scalar-config.js" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NewLife.Cube\NewLife.Cube.csproj" />
  </ItemGroup>

</Project>
