<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WebSmoke</RootNamespace>
    <AssemblyTitle>魔方 Web 指令集冒烟</AssemblyTitle>
    <Description>在目标架构上启动 Kestrel 并完成一次 HTTP 往返，验证 ASP.NET Core 宿主与魔方程序集可用；供 CI 指令集矩阵在 QEMU 容器内执行。</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NewLife.Cube\NewLife.Cube.csproj" />
  </ItemGroup>

</Project>
