{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "core/**/*.vue",
    "core/**/*.ts",
    "core/**/*.tsx",
    "core/**/*.d.ts",
    "apps/**/*.vue",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "configs/**/*.ts",
    "configs/microAppConfig.js",
    "e2e/**/*.ts"
  ],
  "exclude": [
    "src/**",
    "src/**/__tests__/*",
  ],
  "compilerOptions": {
    "jsx": "preserve",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    // @vue/tsconfig 基线把 lib 锁在 ES2020，而框架已在用 Array.prototype.at 等 ES2022 内置方法；
    // 这里显式覆盖为 ES2022，与构建目标（vite build.target）保持一致，避免类型库落后于运行环境。
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "element-plus/global"
    ],
    "paths": {
      "@newlifex/cube-vue": [
        "./"
      ],
      "@newlifex/cube-vue/*": [
        "./*"
      ],
    }
  }
}