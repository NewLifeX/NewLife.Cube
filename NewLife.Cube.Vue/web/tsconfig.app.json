{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "core/**/*.vue",
    "core/**/*.ts",
    "core/**/*.tsx",
    "core/**/*.d.ts",
    "apps/**/*.vue",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "configs/**/*.ts",
    "configs/microAppConfig.js",
    "e2e/**/*.ts"
  ],
  "exclude": [
    "src/**",
    "src/**/__tests__/*",
  ],
  "compilerOptions": {
    "jsx": "preserve",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": [
      "element-plus/global"
    ],
    "paths": {
      "@newlifex/cube-vue": [
        "./"
      ],
      "@newlifex/cube-vue/*": [
        "./*"
      ],
    }
  }
}