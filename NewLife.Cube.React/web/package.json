{
  "name": "@newlifex/cube-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "魔方 React 前端皮肤（第三代 WebAPI），基于 React 18 + Ant Design 5 + Zustand + Vite",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@cube/api-core": "workspace:*",
    "@cube/auth-logic": "workspace:*",
    "@cube/field-mapping": "workspace:*",
    "@cube/page-logic": "workspace:*",
    "@cube/page-utils": "workspace:*",
    "antd": "^6.6.2",
    "axios": "^1.8.4",
    "dayjs": "^1.11.13",
    "dompurify": "^3.2.4",
    "echarts": "^5.6.0",
    "i18next": "^24.2.0",
    "lodash": "^4.17.21",
    "marked": "^15.0.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^15.4.0",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/lodash": "^4.17.15",
    "@types/node": "^22.13.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "jsdom": "^26.0.0",
    "prettier": "3.5.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  }
}
