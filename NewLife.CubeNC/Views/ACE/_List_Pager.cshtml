@using NewLife;
@using NewLife.Web;
@{
    var pager = ViewBag.Page as Pager;
    var set = ViewBag.PageSetting as PageSetting ?? PageSetting.Global;
    var hasNext = ViewBag.HasNext as Boolean? ?? true;
    // GetPageUrl 默认返回完整 <a> 标签（PageUrlTemplate），此处仅需纯链接 URL 填入 href
    pager.PageUrlTemplate = "{链接}";

    var act = Context.Request.Path + "";
    if (act.IsNullOrEmpty()) { act = Url.Action("Index"); }

    // 跳转输入框嵌入译文，兼容不同语言的语序
    var jumpHtml = String.Format(L.T("Go to page {0}"), $"<input name=\"PageIndex\" type=\"text\" value=\"{pager.PageIndex}\" class=\"input-sm\" style=\"width:44px;text-align:center;\" />");
}
@* ACE 主题覆盖：分页器按钮化（保留 PageIndex/PageSize 提交逻辑） *@
@if (pager.TotalCount > 0)
{<text><form action="@act?@pager.GetBaseUrl(true, true, false)" method="post" role="form">
            <span class="pager-info">@Html.Raw(String.Format(L.T("Total {0} · {1} per page · page {2} of {3}"), $"<b>{pager.TotalCount:n0}</b>", $"<b>{pager.PageSize}</b>", $"<b>{pager.PageIndex:n0}</b>", $"<b>{pager.PageCount:n0}</b>"))</span>
            <span class="pager-btns">
                @if (pager.PageIndex > 1)
                {
                    <a class="pager-btn" href="@pager.GetPageUrl(L.T("First"), 1)" title="@L.T("First")"><i class="glyphicon glyphicon-step-backward"></i></a>
                    <a class="pager-btn" href="@pager.GetPageUrl(L.T("Previous"), pager.PageIndex - 1)" title="@L.T("Previous")"><i class="glyphicon glyphicon-chevron-left"></i></a>
                }
                else
                {
                    <span class="pager-btn disabled" title="@L.T("First")"><i class="glyphicon glyphicon-step-backward"></i></span>
                    <span class="pager-btn disabled" title="@L.T("Previous")"><i class="glyphicon glyphicon-chevron-left"></i></span>
                }
                @{
                    var len = 7;
                    var left = (len - 1) / 2;
                    var right = len - left - 1;
                    var start = pager.PageIndex - left;
                    var end = pager.PageIndex + right;
                    if (start < 1) start = 1;
                    if (end > pager.PageCount) end = (Int32)pager.PageCount;
                }
                @for (var i = start; i <= end; i++)
                {
                    if (i == pager.PageIndex)
                    {
                        <span class="pager-btn pager-btn-current">@i</span>
                    }
                    else
                    {
                        <a class="pager-btn" href="@pager.GetPageUrl(i.ToString(), i)">@i</a>
                    }
                }
                @if (pager.PageIndex < pager.PageCount)
                {
                    <a class="pager-btn" href="@pager.GetPageUrl(L.T("Next"), pager.PageIndex + 1)" title="@L.T("Next")"><i class="glyphicon glyphicon-chevron-right"></i></a>
                    <a class="pager-btn" href="@pager.GetPageUrl(L.T("Last"), pager.PageCount)" title="@L.T("Last")"><i class="glyphicon glyphicon-step-forward"></i></a>
                }
                else
                {
                    <span class="pager-btn disabled" title="@L.T("Next")"><i class="glyphicon glyphicon-chevron-right"></i></span>
                    <span class="pager-btn disabled" title="@L.T("Last")"><i class="glyphicon glyphicon-step-forward"></i></span>
                }
            </span>
            <span class="pager-jump">
                @Html.Raw(jumpHtml)
                <button type="submit" class="btn btn-default btn-sm">GO</button>
                @L.T("Page size")
                <select id="PageSize" name="PageSize" onchange="$(this).parents('form').submit();">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="30">30</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="500">500</option>
                    <option value="1000">1000</option>
                </select>
                <script type="text/javascript">
        $(function () {
            $('#PageSize').val(@pager.PageSize);
        });
                </script>
            </span>
        </form></text>}
else if (!set.EnableTotalCount && (hasNext || pager.PageIndex > 1))
{<text><form action="@act?@pager.GetBaseUrl(true, true, false)" method="post" role="form">
            <span class="pager-info">@Html.Raw(String.Format(L.T("{0} per page · page {1}"), $"<b>{pager.PageSize}</b>", $"<b>{pager.PageIndex:n0}</b>"))</span>
            <span class="pager-btns">
                @if (pager.PageIndex > 1)
                {
                    <a class="pager-btn" href="@pager.GetPageUrl(L.T("Previous"), pager.PageIndex - 1)" title="@L.T("Previous")"><i class="glyphicon glyphicon-chevron-left"></i></a>
                }
                else
                {
                    <span class="pager-btn disabled" title="@L.T("Previous")"><i class="glyphicon glyphicon-chevron-left"></i></span>
                }
                @if (hasNext)
                {
                    <a class="pager-btn" href="@pager.GetPageUrl(L.T("Next"), pager.PageIndex + 1)" title="@L.T("Next")"><i class="glyphicon glyphicon-chevron-right"></i></a>
                }
                else
                {
                    <span class="pager-btn disabled" title="@L.T("Next")"><i class="glyphicon glyphicon-chevron-right"></i></span>
                }
            </span>
            <span class="pager-jump">
                @Html.Raw(jumpHtml)
                <button type="submit" class="btn btn-default btn-sm">GO</button>
                @L.T("Page size")
                <select id="PageSize" name="PageSize" onchange="$(this).parents('form').submit();">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="30">30</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="500">500</option>
                    <option value="1000">1000</option>
                </select>
                <script type="text/javascript">
        $(function () {
            $('#PageSize').val(@pager.PageSize);
        });
                </script>
            </span>
        </form></text>}
