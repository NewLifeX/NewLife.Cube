@using NewLife;
@using NewLife.Cube
@using XCode
@{
    var entity = Model as IEntity;
    var set = ViewBag.PageSetting as PageSetting ?? PageSetting.Global;

    var rv = entity.GetRouteKey();
}
@* ACE 主题覆盖：操作列按钮化（保留 editcell/data-action/data-confirm 等关键行为） *@
@if (set.IsReadOnly)
{
    if (this.Has(PermissionFlags.Detail))
    {
        <a href="@Url.Action("Detail", rv)" class="op-btn op-btn-op-detail editcell" title="双击本行任意地方也可以进入查看页"><i class="glyphicon glyphicon-eye-open"></i>查看</a>
    }
}
else if (this.Has(PermissionFlags.Update))
{
    <a href="@Url.Action("Edit", rv)" class="op-btn op-btn-op-edit editcell" title="双击本行任意地方也可以进入编辑表单页"><i class="glyphicon glyphicon-edit"></i>编辑</a>
}
else if (this.Has(PermissionFlags.Detail))
{
    <a href="@Url.Action("Detail", rv)" class="op-btn op-btn-op-detail editcell" title="双击本行任意地方也可以进入查看页"><i class="glyphicon glyphicon-eye-open"></i>查看</a>
}
@if (this.Has(PermissionFlags.Delete))
{
    var fact = ViewBag.Factory as IEntityFactory;
    var fi = (fact == null || fact.Fields == null) ? null : fact.Fields.FirstOrDefault(e => e.Name.EqualIgnoreCase("Deleted", "IsDelete", "IsDeleted"));
    if (fi != null && fi.Type == typeof(Boolean) && (Boolean)entity[fi.Name])
    {
        rv["restore"] = 1;
        <a href="@Url.Action("Delete", rv)" class="op-btn op-btn-op-restore" data-action="action" data-confirm="确认恢复？"><i class="glyphicon glyphicon-transfer"></i>恢复</a>
    }
    else
    {
        <a href="@Url.Action("Delete", rv)" class="op-btn op-btn-op-delete" data-action="action" data-confirm="确认删除？"><i class="glyphicon glyphicon-remove"></i>删除</a>
    }
}
