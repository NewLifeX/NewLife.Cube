@using NewLife;
@using NewLife.Cube
@using XCode
@{
    var entity = Model as IEntity;
    var set = ViewBag.PageSetting as PageSetting ?? PageSetting.Global;

    var rv = entity.GetRouteKey();
}
@* ACE 主题覆盖：操作列按钮化（保留 editcell/data-action/data-confirm 等关键行为） *@
@if (set.IsReadOnly)
{
    if (this.Has(PermissionFlags.Detail))
    {
        <a href="@Url.Action("Detail", rv)" class="op-btn op-btn-op-detail editcell" title="@L.T("Double-click any cell in the row to view the record")"><i class="glyphicon glyphicon-eye-open"></i>@L.T("View")</a>
    }
}
else if (this.Has(PermissionFlags.Update))
{
    <a href="@Url.Action("Edit", rv)" class="op-btn op-btn-op-edit editcell" title="@L.T("Double-click any cell in the row to edit the record")"><i class="glyphicon glyphicon-edit"></i>@L.T("Edit")</a>
}
else if (this.Has(PermissionFlags.Detail))
{
    <a href="@Url.Action("Detail", rv)" class="op-btn op-btn-op-detail editcell" title="@L.T("Double-click any cell in the row to view the record")"><i class="glyphicon glyphicon-eye-open"></i>@L.T("View")</a>
}
@if (this.Has(PermissionFlags.Delete))
{
    var fact = ViewBag.Factory as IEntityFactory;
    var fi = (fact == null || fact.Fields == null) ? null : fact.Fields.FirstOrDefault(e => e.Name.EqualIgnoreCase("Deleted", "IsDelete", "IsDeleted"));
    if (fi != null && fi.Type == typeof(Boolean) && (Boolean)entity[fi.Name])
    {
        rv["restore"] = 1;
        <a href="@Url.Action("Delete", rv)" class="op-btn op-btn-op-restore" data-action="action" data-confirm="@L.T("Confirm restore?")"><i class="glyphicon glyphicon-transfer"></i>@L.T("Undelete")</a>
    }
    else
    {
        <a href="@Url.Action("Delete", rv)" class="op-btn op-btn-op-delete" data-action="action" data-confirm="@L.T("Confirm delete?")"><i class="glyphicon glyphicon-remove"></i>@L.T("Delete")</a>
    }
}
