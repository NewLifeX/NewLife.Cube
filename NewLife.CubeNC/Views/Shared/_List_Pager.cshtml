@using NewLife;
@using NewLife.Web;
@{
    var pager = ViewBag.Page as Pager;
    var set = ViewBag.PageSetting as PageSetting ?? PageSetting.Global;
    var hasNext = ViewBag.HasNext as Boolean? ?? true;
    //page.PageUrlTemplate = page.PageUrlTemplate.Replace("{链接}", Url.Action("Index") + "{链接}");
    // 没有总记录数的时候不显示分页，可以认为不启用分页；免查总数模式仅显示上一页/下一页

    var act = Context.Request.Path + "";
    if (act.IsNullOrEmpty()) { act = Url.Action("Index"); }

    // 跳转输入框嵌入译文，兼容不同语言的语序
    var jumpHtml = String.Format(L.T("Go to page {0}"), $"<input name=\"PageIndex\" type=\"text\" value=\"{pager.PageIndex}\" class=\"input-sm\" style=\"width:40px;text-align:right;\" />");
}
@if (pager.TotalCount > 0)
{<text><form action="@act?@pager.GetBaseUrl(true, true, false)" method="post" role="form">
            @L.T("Total {0} items", pager.TotalCount.ToString("n0"))&nbsp;
            @L.T("{0} per page", pager.PageSize)&nbsp;
            @L.T("Page {0} of {1}", pager.PageIndex.ToString("n0"), pager.PageCount.ToString("n0"))&nbsp;
            @Html.Raw(pager.GetPage(L.T("First")))&nbsp;
            @Html.Raw(pager.GetPage(L.T("Previous")))&nbsp;
            @Html.Raw(pager.GetPage(L.T("Next")))&nbsp;
            @Html.Raw(pager.GetPage(L.T("Last"))) &nbsp;
            @Html.Raw(jumpHtml)
            <input type="submit" value="GO" class="btn btn-deafult btn-sm" />
            @L.T("Page size")
            <select id="PageSize" name="PageSize" onchange="$(this).parents('form').submit();">
                <option value="5">5</option>
                <option value="10">10</option>
                <option value="20">20</option>
                <option value="30">30</option>
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="500">500</option>
                <option value="1000">1000</option>
            </select>
            <script type="text/javascript">
        $(function () {
            $('#PageSize').val(@pager.PageSize);
        });
            </script>
        </form></text>}
else if (!set.EnableTotalCount && (hasNext || pager.PageIndex > 1))
{<text><form action="@act?@pager.GetBaseUrl(true, true, false)" method="post" role="form">
            @L.T("{0} per page", pager.PageSize)&nbsp;
            @if (pager.PageIndex > 1)
            {
                @Html.Raw(pager.GetPageUrl(L.T("Previous"), pager.PageIndex - 1))
            }
            else
            {
                <span>@L.T("Previous")</span>
            }
            &nbsp;
            @if (hasNext)
            {
                @Html.Raw(pager.GetPageUrl(L.T("Next"), pager.PageIndex + 1))
            }
            else
            {
                <span>@L.T("Next")</span>
            }
            &nbsp;
            @Html.Raw(jumpHtml)
            <input type="submit" value="GO" class="btn btn-deafult btn-sm" />
            @L.T("Page size")
            <select id="PageSize" name="PageSize" onchange="$(this).parents('form').submit();">
                <option value="5">5</option>
                <option value="10">10</option>
                <option value="20">20</option>
                <option value="30">30</option>
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="500">500</option>
                <option value="1000">1000</option>
            </select>
            <script type="text/javascript">
        $(function () {
            $('#PageSize').val(@pager.PageSize);
        });
            </script>
        </form></text>}