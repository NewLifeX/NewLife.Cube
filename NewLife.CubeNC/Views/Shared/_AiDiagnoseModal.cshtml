@* AI 诊断结果弹窗 *@
<div class="modal fade" id="aiDiagnoseModal" tabindex="-1" role="dialog" aria-labelledby="aiDiagnoseModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; border-radius: 5px 5px 0 0;">
                <button type="button" class="close" data-dismiss="modal" aria-label="关闭" style="color: #fff; opacity: 0.8;">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="aiDiagnoseModalLabel">
                    <i class="ace-icon fa fa-stethoscope"></i> AI 诊断
                    <small id="aiDiagnoseSubtitle" style="color: rgba(255,255,255,0.7); margin-left: 10px;"></small>
                </h4>
            </div>
            <div class="modal-body" id="aiDiagnoseContent" style="max-height: 70vh; overflow-y: auto; padding: 20px; line-height: 1.8;">
                <div class="text-center" style="padding: 40px 0;">
                    <i class="ace-icon fa fa-spinner fa-spin fa-3x" style="color: #667eea;"></i>
                    <p style="margin-top: 15px; color: #999;">AI 正在诊断系统，请稍候...</p>
                </div>
            </div>
            <div class="modal-footer">
                <span id="aiDiagStatus" style="float: left; color: #999; line-height: 34px;"></span>
                <button type="button" class="btn btn-sm" data-dismiss="modal">关闭</button>
            </div>
        </div>
    </div>
</div>

<style>
    /* AI 诊断结果 Markdown 渲染样式 */
    #aiDiagnoseContent h2 { font-size: 18px; border-bottom: 2px solid #667eea; padding-bottom: 8px; margin-top: 24px; margin-bottom: 12px; color: #333; }
    #aiDiagnoseContent h3 { font-size: 15px; margin-top: 16px; margin-bottom: 8px; color: #555; }
    #aiDiagnoseContent p { margin-bottom: 10px; }
    #aiDiagnoseContent table { width: 100%; border-collapse: collapse; margin-bottom: 12px; }
    #aiDiagnoseContent table th, #aiDiagnoseContent table td { border: 1px solid #ddd; padding: 6px 10px; text-align: left; font-size: 13px; }
    #aiDiagnoseContent table th { background: #f5f5f5; font-weight: 600; }
    #aiDiagnoseContent ul, #aiDiagnoseContent ol { padding-left: 20px; margin-bottom: 10px; }
    #aiDiagnoseContent li { margin-bottom: 4px; }
    #aiDiagnoseContent code { background: #f0f0f0; padding: 2px 6px; border-radius: 3px; font-size: 90%; }
    #aiDiagnoseContent pre { background: #f8f8f8; border: 1px solid #e0e0e0; border-radius: 4px; padding: 12px; overflow-x: auto; }
    #aiDiagnoseContent blockquote { border-left: 4px solid #667eea; padding: 8px 16px; margin: 12px 0; background: #f9f9ff; color: #555; }
    #aiDiagnoseContent strong { color: #333; }
</style>

@* 加载 AI 洞察脚本，定义 window.CubeAI（含 diagnose）。放在组件内自包含 *@
<script src="~/js/ai-insight.js"></script>
