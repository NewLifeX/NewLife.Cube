@using NewLife;
@using NewLife.Web;
@using XCode;
@using System.Linq;
@{
    var page = ViewBag.Page as Pager;
    //var name = (Object)Model + "";
    var name = "";
    if (Model is String str) name = str;
    if (name.IsNullOrEmpty()) name = "enable";

    var dic = new Dictionary<Int32, String>();
    if (name.EqualIgnoreCase("enable"))
    {
        dic.Add(1, L.T("Enabled"));
        dic.Add(0, L.T("Disabled"));
    }
    else if (name.EqualIgnoreCase("success"))
    {
        dic.Add(1, L.T("Succeeded"));
        dic.Add(0, L.T("Failed"));
    }
    else
    {
        dic.Add(1, L.T("Yes"));
        dic.Add(0, L.T("No"));
    }
}
<div class="form-group">
    <label for="@name" class="control-label">@L.T("Status"):</label>
    @await Html.PartialAsync("_Form_DropDownList", new ListBoxModel(name, dic,  page[name], L.T("All"), true, null))
</div>
