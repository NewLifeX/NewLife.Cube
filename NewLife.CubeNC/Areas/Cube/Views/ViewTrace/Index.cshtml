@using Microsoft.AspNetCore.Mvc.ViewEngines
@using NewLife
@{
    var area = ViewBag.Area + "";
    var controller = ViewBag.Controller + "";
    var view = ViewBag.View + "";
    var theme = ViewBag.Theme + "";

    var candidates = ViewBag.Candidates as String[];
    var physical = ViewBag.Physical as Boolean[];
    var result = ViewBag.Result as ViewEngineResult;

    var hitPath = result != null && result.Success ? result.View.Path : null;
}
@section css {
    <style>
        .vt-table { font-size: 13px; }
        .vt-phy { background: #d9f7be !important; }
        .vt-hit { background: #ffd591 !important; font-weight: bold; }
    </style>
}
<div class="page-header">
    <h1>
        @L.T("View resolution diagnostics")
        <small>@L.T("Troubleshoot view override")</small>
    </h1>
</div>

<form class="form-inline" method="get" action="@Url.Action("Index")">
    <div class="form-group">
        <label for="area">@L.T("Area")</label>
        <input type="text" class="form-control input-sm" id="area" name="area" value="@area" placeholder="Admin" />
    </div>
    <div class="form-group">
        <label for="controller">@L.T("Controller")</label>
        <input type="text" class="form-control input-sm" id="controller" name="controller" value="@controller" placeholder="User" />
    </div>
    <div class="form-group">
        <label for="view">@L.T("View")</label>
        <input type="text" class="form-control input-sm" id="view" name="view" value="@view" placeholder="_List_Search" />
    </div>
    <div class="form-group">
        <label for="theme">@L.T("Theme")</label>
        <input type="text" class="form-control input-sm" id="theme" name="theme" value="@theme" placeholder="ACE" />
    </div>
    <button type="submit" class="btn btn-sm btn-primary"><i class="fa fa-search"></i> @L.T("Resolve")</button>
</form>

@if (candidates != null)
{
    <h3>@L.T("① Theoretical candidate paths (ViewLocationHelper, 7 levels of priority)")</h3>
    <table class="table table-bordered table-hover table-condensed vt-table">
        <thead>
            <tr>
                <th style="width:60px;">@L.T("Priority")</th>
                <th>@L.T("Candidate paths")</th>
                <th style="width:100px;">@L.T("Physical file")</th>
                <th style="width:100px;">@L.T("Actual hit")</th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < candidates.Length; i++)
            {
                var cls = physical[i] ? "vt-phy" : "";
                if (hitPath != null && hitPath.EqualIgnoreCase(candidates[i])) cls += " vt-hit";
                <tr class="@cls">
                    <td class="text-center">@(i + 1)</td>
                    <td>@candidates[i]</td>
                    <td class="text-center">@(physical[i] ? L.T("✅ Exists") : "—")</td>
                    <td class="text-center">@(hitPath != null && hitPath.EqualIgnoreCase(candidates[i]) ? L.T("⭐ Hit") : "—")</td>
                </tr>
            }
        </tbody>
    </table>
}

<h3>@L.T("② Actual lookup result of the view engine")</h3>
@if (result == null)
{
    <div class="alert alert-warning">@L.T("No results")</div>
}
else if (result.Success)
{
    <div class="alert alert-success">
        <strong>@L.T("Hit:")</strong>@result.View.Path
    </div>
}
else
{
    <div class="alert alert-danger"><strong>@L.T("No hit!")</strong>@L.T("The view was not found in any of the following locations.")</div>
    <table class="table table-bordered table-hover table-condensed vt-table">
        <thead>
            <tr><th>@L.T("Actual lookup locations (in order)")</th></tr>
        </thead>
        <tbody>
            @foreach (var item in result.SearchedLocations)
            {
                <tr><td>@item</td></tr>
            }
        </tbody>
    </table>
}

<div class="alert alert-info">
    <strong>@L.T("Note:")</strong>
    @L.T("Green row = the physical file exists (right location); orange row = matches the actual hit of the view engine.")
    @L.T("If the override does not take effect, first check in ① whether your file appears and whether it is shadowed by a higher priority, then check the actual hit in ②.")
</div>
