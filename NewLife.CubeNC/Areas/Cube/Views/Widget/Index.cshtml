@using NewLife.Cube.Widgets
@using NewLife;
@{
    ViewBag.Title = L.T("Dashboard widgets");

    var list = ViewBag.Widgets as IList<WidgetAttribute> ?? new List<WidgetAttribute>();
    var enabled = ViewBag.Enabled as IDictionary<String, Boolean> ?? new Dictionary<String, Boolean>();
}
<div class="page-header">
    <h1>
        @L.T("Dashboard widgets")
        <small>@L.T("Shown on the dashboard when enabled, hidden immediately when disabled (global setting stored in the Parameter table)")</small>
    </h1>
</div>
<div class="panel panel-default" style="max-width:760px;">
    <div class="panel-heading">
        <i class="fa fa-sort-amount-asc"></i> @L.T("Group display order")
        <small class="text-muted">@L.T("Cards in the same group are aggregated by default; unlisted groups come last and are ordered by name (comma separated, e.g. System,Profile,Common,IoT)")</small>
    </div>
    <div class="panel-body">
        <div class="input-group">
            <input type="text" id="group-order" class="form-control" value="@(ViewBag.GroupOrder)" placeholder="@L.T("System,Profile,Common")" />
            <span class="input-group-btn">
                <button type="button" class="btn btn-primary" onclick="saveGroupOrder()">@L.T("Save")</button>
            </span>
        </div>
    </div>
</div>
@{
    var groupItems = ViewBag.GroupItems as IDictionary<String, IList<String>> ?? new Dictionary<String, IList<String>>();
    var titles = list.ToDictionary(e => e.Name, e => e.Title, StringComparer.OrdinalIgnoreCase);
}
@if (groupItems.Count > 0)
{
    <div class="panel panel-default" style="max-width:760px;">
        <div class="panel-heading">
            <i class="fa fa-list-ol"></i> @L.T("Default order in group")
            <small class="text-muted">@L.T("One group per line with widget names separated by commas; groups left blank are ordered by widget Sort; new widgets are appended to the end of their group")</small>
        </div>
        <div class="panel-body">
            @foreach (var kv in groupItems)
            {
                <div class="form-group" style="margin-bottom:8px;">
                    <label style="font-weight:600;margin-bottom:2px;">@kv.Key</label>
                    <input type="text" class="form-control group-item-order" data-group="@kv.Key"
                           value="@(String.Join(",", kv.Value))" title="@(String.Join(", ", kv.Value.Select(n => titles.TryGetValue(n, out var t) ? $"{n}({L.T(t)})" : n)))" />
                </div>
            }
            <button type="button" class="btn btn-primary" onclick="saveGroupItems()">@L.T("Save order within group")</button>
        </div>
    </div>
}
<table class="table table-bordered table-hover table-striped table-condensed table-data-list">
    <thead>
        <tr>
            <th>@L.T("Name")</th>
            <th>@L.T("Title")</th>
            <th>@L.T("Icon")</th>
            <th style="width:60px;">@L.T("Width")</th>
            <th>@L.T("Category")</th>
            <th>@L.T("Visibility")</th>
            <th style="width:80px;">@L.T("Status")</th>
            <th style="width:90px;">@L.T("Operation")</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in list)
        {
            var enable = enabled.TryGetValue(item.Name, out var en) ? en : true;
            <tr>
                <td>@item.Name</td>
                <td>@L.T(item.Title)</td>
                <td><i class="fa @item.Icon"></i> <span class="text-muted">@item.Icon</span></td>
                <td class="text-center">@item.Cols</td>
                <td>@L.T(item.Category)</td>
                <td>@(item.AdminOnly ? L.T("Administrators only") : (item.Permission.IsNullOrEmpty() ? L.T("All users") : item.Permission))</td>
                <td class="text-center">@(enable ? L.T("✅ Enabled") : L.T("⛔ Disabled"))</td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm @(enable ? "btn-danger" : "btn-success")" onclick="toggle('@item.Name', @(!enable ? "true" : "false"))">
                        @(enable ? L.T("Disabled") : L.T("Enabled"))
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@section scripts {
    <script>
        function toggle(name, enable) {
            $.post('@Url.Action("Enable")', { name: name, enable: enable }, function () {
                location.reload();
            });
        }

        function saveGroupOrder() {
            $.post('@Url.Action("SaveGroupOrder")', { groups: $('#group-order').val() }, function () {
                location.reload();
            });
        }

        function saveGroupItems() {
            // 等待所有组内顺序 POST 完成后再刷新，避免 reload 中断未完成的请求
            var posts = [];
            $('.group-item-order').each(function () {
                posts.push($.post('@Url.Action("SaveGroupItemOrder")', { group: $(this).data('group'), names: $(this).val() }));
            });
            $.when.apply($, posts).then(function () { location.reload(); });
        }
    </script>
}
