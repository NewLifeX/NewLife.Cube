@model IList<UserToken>
@using NewLife.Cube.Entity
@using NewLife;
@using NewLife.Web;
@using XCode;
@using XCode.Configuration;
@using XCode.Membership;
@using NewLife.Cube;
@{
    var fact = ViewBag.Factory as IEntityFactory;
    var page = ViewBag.Page as Pager;
    var set = ViewBag.PageSetting as PageSetting ?? PageSetting.Global;
    var provider = ManageProvider.Provider;
}
<table class="table table-bordered table-hover table-striped table-condensed">
    <thead>
        <tr>
            @if (set.EnableSelect)
            {
                <th class="text-center" style="width:10px;"><input type="checkbox" id="chkAll" title="@L.T("Select all")" /></th>
            }
            <th class="text-center"><a href="@Html.Raw(page.GetSortUrl("Token"))">@L.T("Token")</a></th>
            <th class="text-center" title="@L.T("Address. When locked, the token can only access this resource path")"><a href="@Html.Raw(page.GetSortUrl("Url"))">@L.T("Address")</a></th>
            <th class="text-center">@L.T("Page")</th>
            <th class="text-center">@L.T("Json data")</th>
            <th class="text-center">@L.T("Xml data")</th>
            <th class="text-center">@L.T("Csv data")</th>
            <th class="text-center">@L.T("Excel data")</th>
            <th class="text-center" title="@L.T("User. Local user")"><a href="@Html.Raw(page.GetSortUrl("UserID"))">@L.T("User")</a></th>
            <th class="text-center" style="min-width:134px;"><a href="@Html.Raw(page.GetSortUrl("Expire"))">@L.T("Expiration time")</a></th>
            <th class="text-center"><a href="@Html.Raw(page.GetSortUrl("Enable"))">@L.T("Enabled")</a></th>
            <th class="text-center" title="@L.T("Times. How many times this token has been used")"><a href="@Html.Raw(page.GetSortUrl("Times"))">@L.T("Share count")</a></th>
            <th class="text-center"><a href="@Html.Raw(page.GetSortUrl("LastIP"))">@L.T("Last address")</a></th>
            <th class="text-center" style="min-width:134px;"><a href="@Html.Raw(page.GetSortUrl("LastTime"))">@L.T("Last time")</a></th>
            <th class="text-center"><a href="@Html.Raw(page.GetSortUrl("UpdateIP"))">@L.T("Update address")</a></th>
            <th class="text-center" style="min-width:134px;"><a href="@Html.Raw(page.GetSortUrl("UpdateTime"))">@L.T("Update time")</a></th>
            @if (this.Has(PermissionFlags.Detail, PermissionFlags.Update, PermissionFlags.Delete))
            {
                <th class="text-center">@L.T("Operation")</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var entity in Model)
        {
            var url = entity.Url + "";
            var query = "";
            var p = url.IndexOf('?');
            if (p >= 0)
            {
                query = url.Substring(p);
                url = url.Substring(0, p);
            }
            if (!query.IsNullOrEmpty())
                query += "&token=" + entity.Token;
            else
                query += "?token=" + entity.Token;

            <tr>
                @if (set.EnableSelect)
                {
                    <td class="text-center"><input type="checkbox" name="keys" value="@entity.ID" /></td>
                }
                <td>@entity.Token</td>
                <td style="max-width:400px;overflow:hidden;white-space: nowrap;text-overflow: ellipsis;" title="@entity.Url">@entity.Url</td>
                <td class="text-center"><a href="@(url+"/Html"+query)" target="_blank">@L.T("Page")</a></td>
                <td class="text-center"><a href="@(url+"/Json"+query)" target="_blank">@L.T("Json data")</a></td>
                <td class="text-center"><a href="@(url+"/Xml"+query)" target="_blank">@L.T("Xml data")</a></td>
                <td class="text-center"><a href="@(url+"/Csv"+query)" target="_blank">@L.T("Csv data")</a></td>
                <td class="text-center"><a href="@(url+"/Excel"+query)" target="_blank">@L.T("Excel data")</a></td>
                <td class="text-center">@entity.UserName</td>
                <td class="text-center">@entity.Expire.ToFullString("")</td>
                <td class="text-center">
                    <i class="glyphicon glyphicon-@(entity.Enable ? "ok" : "remove")" style="color: @(entity.Enable ? "green" : "red");"></i>
                </td>
                <td class="text-right">@entity.Times.ToString("n0")</td>
                <td>@entity.LastIP.IPToAddress()</td>
                <td class="text-center">@entity.LastTime.ToFullString("")</td>
                <td class="text-center">@entity.UpdateIP.IPToAddress()</td>
                <td class="text-center">@entity.UpdateTime</td>
                @if (this.Has(PermissionFlags.Detail, PermissionFlags.Update, PermissionFlags.Delete))
                {
                    <td class="text-center">
                        @await Html.PartialAsync("_List_Data_Action", (Object)entity)
                    </td>
                }
            </tr>
        }
    </tbody>
</table>