@{
    var Obj = Model as Object;

    // 设置页之间切换时保留当前语言参数
    var lang = Context.Request.Query["lang"].ToString();
    var route = lang.IsNullOrEmpty() ? null : new { lang };
}
<div class="text-center col-md-12">
    @Html.ActionLink(L.T("Basic settings"), "Index", "Core", route, new { @class = "layui-btn layui-btn-sm" })
    @Html.ActionLink(L.T("System settings"), "Index", "Sys", route, new { @class = "layui-btn layui-btn-sm" })
    @Html.ActionLink(L.T("Data middleware"), "Index", "XCode", route, new { @class = "layui-btn layui-btn-sm" })
    @Html.ActionLink(L.T("Cube settings"), "Index", "Cube", route, new { @class = "layui-btn layui-btn-sm" })
    @Html.ActionLink(L.T("OAuth settings"), "Index", "OAuthConfig", route, new { @class = "layui-btn layui-btn-sm" })
</div>