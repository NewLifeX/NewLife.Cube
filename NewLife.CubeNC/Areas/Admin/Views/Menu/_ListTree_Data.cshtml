@model IList<XCode.Membership.Menu>
@using NewLife;
@using NewLife.Web;
@using XCode;
@using XCode.Configuration;
@{
    var fact = ViewBag.Factory as IEntityFactory;
    var page = ViewBag.Page as Pager;
    var parentId = page["parentId"].ToInt(-1);
    var set = ViewBag.PageSetting as PageSetting ?? PageSetting.Global;
}
<table class="table table-bordered table-hover table-striped table-condensed">
    <thead>
        <tr>
            @if (set.EnableSelect)
            {
                <th class="text-center" style="width:10px;"><input type="checkbox" id="chkAll" title="@L.T("Select all")" /></th>
            }
            <th class="text-center"><a href="@Html.Raw(page.GetSortUrl("ID"))">@L.T("ID")</a></th>
            <th class="text-center"><a href="@Html.Raw(page.GetSortUrl("TreeNodeName"))">@L.T("Node name")</a></th>
            <th class="text-center"><a href="@Html.Raw(page.GetSortUrl("Icon"))">@L.T("Icon")</a></th>
            <th class="text-center"><a href="@Html.Raw(page.GetSortUrl("DisplayName"))">@L.T("Display name")</a></th>
            <th class="text-center"><a href="@Html.Raw(page.GetSortUrl("Url"))">@L.T("Link")</a></th>
            <th class="text-center"><a href="@Html.Raw(page.GetSortUrl("Sort"))">@L.T("Sort")</a></th>
            @*<th class="text-center"><a href="@Html.Raw(page.GetSortUrl("Icon"))">图标</a></th>*@
            <th class="text-center"><a href="@Html.Raw(page.GetSortUrl("Visible"))">@L.T("Visible")</a></th>
            <th class="text-center" title="@L.T("Required. A required menu must be owned by at least one role; otherwise it is granted to the system role automatically")"><a href="@Html.Raw(page.GetSortUrl("Necessary"))">@L.T("Required")</a></th>
            <th class="text-center" title="@L.T("Permission items. Separated by commas; each item's name and value are separated by a vertical bar")"><a href="@Html.Raw(page.GetSortUrl("Permission"))">@L.T("Permission items")</a></th>
            @if (this.Has(PermissionFlags.Detail, PermissionFlags.Update, PermissionFlags.Delete))
            {
                <th class="text-center">@L.T("Asc")</th>
                <th class="text-center">@L.T("Desc")</th>
                <th class="text-center">@L.T("Operation")</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var entity in Model)
        {
            var p = entity.Parent as IEntityTree;
            if (p == null)
            {
                p = fact.EntityType.GetValue("Root") as IEntityTree;
            }
            var id = entity.ID;
            <tr>
                @if (set.EnableSelect)
                {
                    <td class="text-center"><input type="checkbox" name="keys" value="@entity.ID" /></td>
                }
                <td class="text-center">@entity.ID</td>
                <td><a href="?parentId=@entity.ID">@entity.TreeNodeName</a></td>
                <td class="text-center">
                    @if (entity.Icon.StartsWithIgnoreCase("fa-"))
                    {
                        <i class="menu-icon fa @entity.Icon"></i>
                    }
                    else
                    {
                        <text>@entity.Icon</text>
                    }
                </td>
                <td>@entity.DisplayName</td>
                <td>@entity.Url</td>
                <td class="text-right">@entity.Sort.ToString("n0")</td>
                @*<td>@entity.Icon</td>*@
                <td class="text-center">
                    @await Html.PartialAsync("_Icon_Boolean", entity.Visible)
                </td>
                <td class="text-center">
                    @await Html.PartialAsync("_Icon_Boolean", entity.Necessary)
                </td>
                <td>@entity.Permission</td>
                @if (this.Has(PermissionFlags.Detail, PermissionFlags.Update, PermissionFlags.Delete))
                {
                    <td class="text-center">
                        @if (p != null && p.Childs != null && p.Childs.Count > 0 && entity != p.Childs[0])
                        {
                            <a href="@Url.Action("Up", new { id, parentId })">
                                @await Html.PartialAsync("_Icon_Arrow", true)
                            </a>
                        }
                    </td>
                    <td class="text-center">
                        @if (p != null && entity != p.Childs[p.Childs.Count - 1])
                        {
                            <a href="@Url.Action("Down", new { id, parentId })">
                                @await Html.PartialAsync("_Icon_Arrow", false)
                            </a>
                        }
                    </td>
                    <td class="text-center">
                        @await Html.PartialAsync("_List_Data_Action", (Object)entity)
                    </td>
                }
            </tr>
        }
    </tbody>
</table>