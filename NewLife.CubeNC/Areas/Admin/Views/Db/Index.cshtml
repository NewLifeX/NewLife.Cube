@using NewLife.Common;
@using NewLife.Cube.Areas.Admin;
@using XCode.DataAccessLayer;
@{
    //Layout = NewLife.Cube.Setting.Current.Layout;

    var dbs = Model as IList<DbItem>;
}
<table class="table table-bordered table-hover table-striped table-condensed">
    <thead>
        <tr>
            <th class="text-center">@L.T("Name")</th>
            <th class="text-center">@L.T("Type")</th>
            <th class="text-center">@L.T("Connection string")</th>
            <th class="text-center">@L.T("Database version")</th>
            <th class="text-center">@L.T("Driver")</th>
            <th class="text-center">@L.T("Driver version")</th>
            <th class="text-center">@L.T("Entities")</th>
            <th class="text-center">@L.T("Tables")</th>
            <th class="text-center">@L.T("Compact")</th>
            <th class="text-center">@L.T("Backup")</th>
            <th class="text-center">@L.T("Backup and compress")</th>
            <th class="text-center">@L.T("Download table schema")</th>
            <th class="text-center">@L.T("Model differences")</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in dbs)
        {
            var dal = DAL.Create(item.Name);
            var pk = dal.ProtectedKey;

            // 密码需要保密
            var str = pk.Hide(item.ConnStr);
            var str2 = pk.Hide(dal.Db.ConnectionString);

            <tr>
                <td>@item.Name</td>
                <td>@item.Type</td>
                <td style="max-width:600px;overflow:hidden;white-space: nowrap;text-overflow: ellipsis;" title="@str2">@str</td>
                <td>@item.Version</td>
                <td>@item.Driver</td>
                <td>@item.DriverVersion</td>
                <td class="text-center">@Html.ActionLink(item.Entities + "", "ShowEntities", new { Name = item.Name })</td>
                <td class="text-center">@Html.ActionLink(item.Tables + "", "ShowTables", new { Name = item.Name })</td>
                <td class="text-center">@Html.ActionLink(L.T("Compact"), "Compact", new { Name = item.Name })</td>
                <td>@Html.ActionLink(L.T("Backup"), "Backup", new { Name = item.Name })@L.T(", {0} total", item.Backups.ToString("n0"))</td>
                <td>@Html.ActionLink(L.T("Backup and compress"), "BackupAndCompress", new { Name = item.Name })</td>
                <td class="text-center">@Html.ActionLink(L.T("Download"), "Download", new { Name = item.Name })</td>
                <td class="text-center">@Html.ActionLink(L.T("View differences"), "ModelDiff", new { Name = item.Name })</td>
            </tr>
        }
    </tbody>
</table>