@model DbDiffModel
@using NewLife.Cube.Areas.Admin.Models
@using XCode.DataAccessLayer
@{
    ViewBag.Title = L.T("Model differences") + " - " + Model.Name;
}

<h3>@L.T("Model differences of database {0}", Model.Name)</h3>
@if (Model.Tables == null || Model.Tables.Count == 0)
{
    <div class="alert alert-success">
        <strong>@L.T("Great!")</strong>@L.T("The database matches the entity model exactly; no differences found.")
    </div>
}
else
{
    <div class="alert alert-info">
        @L.T("Found {0} tables with differences (extra fields in the database).", Model.Tables.Count)
        @L.T("Paste the XML fragment below into the corresponding Model.xml file, then regenerate the entity classes.")
    </div>

    @foreach (var item in Model.Tables)
    {
        <div class="panel panel-default">
            <div class="panel-heading">
                @if (!item.HasEntityModel)
                {
                    <span class="label label-warning">@L.T("No entity class")</span>
                }
                else
                {
                    <span class="label label-primary">@L.T("Has entity class")</span>
                }
                &nbsp;
                @if (!item.DisplayName.IsNullOrEmpty() && !item.DisplayName.EqualIgnoreCase(item.TableName))
                {
                    <strong>@item.DisplayName</strong>
                    <span class="text-muted">(@item.Name / @item.TableName)</span>
                }
                else
                {
                    <strong>@item.Name</strong>
                    @if (!item.TableName.EqualIgnoreCase(item.Name))
                    {
                        <span class="text-muted">(@item.TableName)</span>
                    }
                }
                <span class="badge">@L.T("{0} fields", item.ExtraColumns.Count)</span>
                @if (!item.HasEntityModel)
                {
                    <small class="text-warning"> @L.T("— This table does not exist in the entity model; all fields are listed below")</small>
                }
            </div>
            <div class="panel-body">
                <table class="table table-bordered table-hover table-striped table-condensed">
                    <thead>
                        <tr>
                            <th class="text-center">@L.T("Column name")</th>
                            <th class="text-center">@L.T("Display name")</th>
                            <th class="text-center">@L.T("Type")</th>
                            <th class="text-center">@L.T("Length")</th>
                            <th class="text-center">@L.T("Precision")</th>
                            <th class="text-center">@L.T("Primary key")</th>
                            <th class="text-center">@L.T("Allow null")</th>
                            <th class="text-center">@L.T("Remark")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var col in item.ExtraColumns)
                        {
                            <tr>
                                <td>@col.ColumnName</td>
                                <td>@col.DisplayName</td>
                                <td class="text-center">@(col.RawType ?? col.DataType?.FullName.TrimPrefix("System."))</td>

                                @if (col.Length > 0)
                                {
                                    <td class="text-center">@col.Length</td>
                                }
                                else
                                {
                                    <td></td>
                                }

                                @if (col.Precision > 0 || col.Scale > 0)
                                {
                                    <td class="text-center">(@col.Precision, @col.Scale)</td>
                                }
                                else
                                {
                                    <td></td>
                                }

                                @if (col.Identity)
                                {
                                    <td title="@L.T("Auto increment")" class="text-center">AI</td>
                                }
                                else if (col.PrimaryKey)
                                {
                                    <td title="@L.T("Primary key")" class="text-center">PK</td>
                                }
                                else
                                {
                                    <td></td>
                                }

                                <td class="text-center">@(col.Nullable ? "" : "N")</td>
                                <td>@(col.Description?.TrimPrefix(col.DisplayName).TrimPrefix("。", "，"))</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <h5>@L.T("XML fragment (paste into the <Columns> node of Model.xml):")</h5>
                <div class="input-group" style="margin-bottom:4px;">
                    <button class="btn btn-sm btn-default copy-btn" data-target="#xml-@item.TableName"
                            title="@L.T("Copy to clipboard")">
                        <i class="fa fa-copy"></i> @L.T("Copy")
                    </button>
                </div>
                <pre id="xml-@item.TableName" style="background:#f5f5f5;border:1px solid #ddd;padding:10px;border-radius:4px;white-space:pre-wrap;word-break:break-all;font-size:12px;">@item.XmlFragment</pre>
            </div>
        </div>
    }
}

<div style="margin-top:10px;">
    @Html.ActionLink(L.T("« Back to database list"), "Index")
</div>

@section scripts{
<script>
    document.querySelectorAll('.copy-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var targetId = btn.getAttribute('data-target');
            var pre = document.querySelector(targetId);
            if (!pre) return;
            var text = pre.textContent || pre.innerText;
            if (navigator.clipboard) {
                navigator.clipboard.writeText(text).then(function () {
                    btn.textContent = '@L.T("✓ Copied")';
                    setTimeout(function () { btn.innerHTML = '<i class="fa fa-copy"></i> @L.T("Copy")'; }, 2000);
                });
            } else {
                var ta = document.createElement('textarea');
                ta.value = text;
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
                btn.textContent = '@L.T("✓ Copied")';
                setTimeout(function () { btn.innerHTML = '<i class="fa fa-copy"></i> @L.T("Copy")'; }, 2000);
            }
        });
    });
</script>
}
