@model XCode.Membership.User
@using System.Linq
@using System.Reflection
@using XCode
@using XCode.Configuration
@using NewLife.Cube.Entity;
@{
    var fact = EntityFactory.CreateFactory(ViewData.ModelMetadata.ModelType);
    var user = Model as IUser;
    var user2 = user as User;

    // 角色徽章配色
    var roleColors = new[] { "label-primary", "label-success", "label-info", "label-warning", "label-danger" };
    var roles = user?.Roles;
    var idx = 0;
}
<div class="profile-wrap">
    @await Html.PartialAsync("_User_Nav")

    @if (ViewBag.StatusMessage != null)
{
    <div class="alert alert-success alert-dismissible text-center" role="alert">
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <strong>@ViewBag.StatusMessage</strong>
    </div>
}

<!-- 个人信息头卡 -->
<div class="profile-card">
    <div class="profile-head">
        <div class="profile-avatar">
            @if (!user.Avatar.IsNullOrEmpty())
            {
                <img src="@user.GetAvatarUrl()" alt="头像" />
            }
            else
            {
                <span class="avatar-fallback"><i class="fa fa-user"></i></span>
            }
        </div>
        <div class="profile-info">
            <div class="profile-name">
                @user.DisplayName
                <span class="profile-username"><i class="fa fa-user-o"></i> @user.Name</span>
            </div>
            <div class="profile-badges">
                @if (roles != null)
                {
                    foreach (var r in roles)
                    {
                        var cls = roleColors[idx++ % roleColors.Length];
                        <span class="label @cls">@r</span>
                    }
                }
            </div>
        </div>
    </div>
    <div class="profile-stats">
        <div class="stat-item">
            <div class="stat-num">@user.Logins</div>
            <div class="stat-label">登录次数</div>
        </div>
        <div class="stat-item">
            <div class="stat-num">@user.LastLogin.ToFullString("")</div>
            <div class="stat-label">最后登录</div>
        </div>
        <div class="stat-item">
            <div class="stat-num">@(user2?.DepartmentName)</div>
            <div class="stat-label">所属部门</div>
        </div>
        <div class="stat-item">
            <div class="stat-num">@user.LastLoginIP</div>
            <div class="stat-label">最后登录IP</div>
        </div>
    </div>
</div>

@using (Html.BeginForm("Info", null, new { id = Model[fact.Unique.Name] }, FormMethod.Post, null, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
    @Html.ValidationSummary()

    <!-- 基础信息 -->
    <div class="form-section">
        <div class="form-section-title"><i class="fa fa-id-card-o"></i>基础信息</div>
        <div class="form-section-body">
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-sm-4">名称</label>
                        <div class="col-sm-8">
                            <input value="@user.Name" class="form-control" disabled="disabled" />
                            <span class="help-text">登录名，不可修改</span>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-sm-4">显示名</label>
                        <div class="col-sm-8">
                            @Html.ForEditor("DisplayName")
                            @Html.ForDescription("DisplayName")
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-sm-4">性别</label>
                        <div class="col-sm-8">
                            @Html.ForEditor("Sex", user.Sex)
                            @Html.ForDescription("Sex")
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-sm-4">生日</label>
                        <div class="col-sm-8">
                            <div class="input-group">
                                @Html.ForEditor("Birthday")
                            </div>
                            <span class="help-text">@Html.ForDescription("Birthday")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 联系方式 -->
    <div class="form-section">
        <div class="form-section-title"><i class="fa fa-envelope-o"></i>联系方式</div>
        <div class="form-section-body">
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-sm-4">邮件</label>
                        <div class="col-sm-8">
                            @Html.ForEditor("Mail")
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-sm-4">手机</label>
                        <div class="col-sm-8">
                            @Html.ForEditor("Mobile")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 身份信息 -->
    <div class="form-section">
        <div class="form-section-title"><i class="fa fa-shield"></i>身份信息</div>
        <div class="form-section-body">
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-sm-4">代码</label>
                        <div class="col-sm-8">
                            @Html.ForEditor("Code")
                            <span class="help-text">@Html.ForDescription("Code")</span>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-sm-4">角色</label>
                        <div class="col-sm-8">
                            <p class="form-value">
                                @if (roles != null)
                                {
                                    foreach (var r in roles)
                                    {
                                        <span class="label label-primary">@r</span>
                                    }
                                }
                            </p>
                            <span class="help-text">主要角色与次要角色</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-sm-4">部门</label>
                        <div class="col-sm-8">
                            <p class="form-value"><i class="fa fa-sitemap"></i>@(user2?.DepartmentName)</p>
                            <span class="help-text">@Html.ForDescription("Department")</span>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-sm-4">头像</label>
                        <div class="col-sm-8 avatar-upload">
                            <span class="avatar-thumb">
                                @if (!user.Avatar.IsNullOrEmpty())
                                {
                                    <img src="@user.GetAvatarUrl()" />
                                }
                                else
                                {
                                    <i class="fa fa-user"></i>
                                }
                            </span>
                            <span class="upload-box">
                                <span class="btn btn-sm btn-default btn-file">
                                    <i class="fa fa-upload"></i> 选择文件
                                    <input type="file" name="Avatar" accept="image/*" />
                                </span>
                                <span class="help-text">@user.Avatar</span>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 登录信息 -->
    <div class="form-section">
        <div class="form-section-title"><i class="fa fa-clock-o"></i>登录信息</div>
        <div class="form-section-body">
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-sm-4">登录次数</label>
                        <div class="col-sm-8">
                            <p class="form-value"><i class="fa fa-sign-in"></i>@user.Logins</p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-sm-4">最后登录</label>
                        <div class="col-sm-8">
                            <p class="form-value"><i class="fa fa-calendar-o"></i>@user.LastLogin.ToFullString("")</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-sm-4">最后登录IP</label>
                        <div class="col-sm-8">
                            <p class="form-value"><i class="fa fa-globe"></i>@user.LastLoginIP</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group">
                        <label class="control-label col-sm-2">备注</label>
                        <div class="col-sm-10">
                            @Html.ForEditor("Remark")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 操作栏 -->
    <div class="profile-actions">
        <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> 保存</button>
        <button type="button" class="btn btn-default" onclick="history.go(-1);"><i class="fa fa-times"></i> 取消</button>
    </div>
}

<!-- 安全中心：更换绑定 / 导出数据 / 注销账号（依据《个人信息保护法》） -->
<div class="form-section">
    <div class="form-section-title"><i class="fa fa-lock"></i>安全中心</div>
    <div class="form-section-body">
        <!-- 更换手机 -->
        <div class="row">
            <div class="col-sm-12">
                <div class="form-group">
                    <label class="control-label col-sm-4">手机号</label>
                    <div class="col-sm-8">
                        <p class="form-value" id="sec_mobile_show">@(user.Mobile.IsNullOrEmpty() ? "未绑定" : user.Mobile)</p>
                        <div id="sec_mobile_edit" style="display:none; max-width:420px;" class="input-group">
                            <input type="tel" class="form-control" id="sec_mobile_new" placeholder="新手机号" maxlength="11" />
                            <span class="input-group-btn"><button type="button" class="btn btn-default" id="sec_mobile_send">发送验证码</button></span>
                        </div>
                        <div id="sec_mobile_code" style="display:none; max-width:420px; margin-top:6px;" class="input-group">
                            <input type="text" class="form-control" id="sec_mobile_code_input" placeholder="短信验证码" />
                            <span class="input-group-btn"><button type="button" class="btn btn-success" id="sec_mobile_confirm">确认绑定</button></span>
                        </div>
                        <div style="margin-top:6px;">
                            <button type="button" class="btn btn-sm btn-default" id="sec_mobile_toggle"><i class="fa fa-exchange"></i> @(user.Mobile.IsNullOrEmpty() ? "绑定" : "更换")</button>
                            <span class="help-text">更换后旧手机号不再可用，新手机号需短信验证码验证</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- 更换邮箱 -->
        <div class="row">
            <div class="col-sm-12">
                <div class="form-group">
                    <label class="control-label col-sm-4">邮箱</label>
                    <div class="col-sm-8">
                        <p class="form-value" id="sec_mail_show">@(user.Mail.IsNullOrEmpty() ? "未绑定" : user.Mail)</p>
                        <div id="sec_mail_edit" style="display:none; max-width:420px;" class="input-group">
                            <input type="email" class="form-control" id="sec_mail_new" placeholder="新邮箱" />
                            <span class="input-group-btn"><button type="button" class="btn btn-default" id="sec_mail_send">发送验证码</button></span>
                        </div>
                        <div id="sec_mail_code" style="display:none; max-width:420px; margin-top:6px;" class="input-group">
                            <input type="text" class="form-control" id="sec_mail_code_input" placeholder="邮箱验证码" />
                            <span class="input-group-btn"><button type="button" class="btn btn-success" id="sec_mail_confirm">确认绑定</button></span>
                        </div>
                        <div style="margin-top:6px;">
                            <button type="button" class="btn btn-sm btn-default" id="sec_mail_toggle"><i class="fa fa-exchange"></i> @(user.Mail.IsNullOrEmpty() ? "绑定" : "更换")</button>
                            <span class="help-text">更换后旧邮箱不再可用，新邮箱需邮件验证码验证</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- 导出个人数据 -->
        <div class="row">
            <div class="col-sm-12">
                <div class="form-group">
                    <label class="control-label col-sm-4">个人数据</label>
                    <div class="col-sm-8">
                        <a href="@Url.Action("ExportData")" class="btn btn-sm btn-info"><i class="fa fa-download"></i> 导出个人数据</a>
                        <span class="help-text">依据《中华人民共和国个人信息保护法》提供数据可携带权，导出 JSON 文件</span>
                    </div>
                </div>
            </div>
        </div>
        <!-- 注销账号 -->
        <div class="row">
            <div class="col-sm-12">
                <div class="form-group">
                    <label class="control-label col-sm-4">注销账号</label>
                    <div class="col-sm-8">
                        <button type="button" class="btn btn-sm btn-danger" id="sec_close_btn"><i class="fa fa-times-circle"></i> 注销账号</button>
                        <span class="help-text">依据《中华人民共和国个人信息保护法》提供账号注销。注销后账号禁用，个性化数据将清空且不可恢复</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // jQuery 在页面底部加载，这里需等待其就绪后再绑定事件
    (function () {
        function init() {
            if (typeof jQuery === 'undefined') { setTimeout(init, 100); return; }
            jQuery(function () {
                // ========== 更换手机（验证码绑定） ==========
                $('#sec_mobile_toggle').on('click', function () { $('#sec_mobile_edit').toggle(); });
                $('#sec_mobile_send').on('click', function () {
                    var m = $('#sec_mobile_new').val();
                    if (!m || !/^1\d{10}$/.test(m)) { alert('请输入正确的手机号'); return; }
                    $.ajax({
                        url: '@Url.Action("SendVerifyCode", "User", new { area = "Admin" })',
                        type: 'POST',
                        data: { channel: 'Sms', username: m, action: 'Bind' },
                        dataType: 'json'
                    }).done(function (d) {
                        if (d && d.code == 0) { $('#sec_mobile_code').show(); } else { alert((d && d.message) || '发送失败'); }
                    }).fail(function () { alert('发送失败，请稍后重试'); });
                });
                $('#sec_mobile_confirm').on('click', function () {
                    var m = $('#sec_mobile_new').val();
                    var code = $('#sec_mobile_code_input').val();
                    if (!m) { alert('请输入手机号'); return; }
                    if (!code) { alert('请输入验证码'); return; }
                    $.ajax({
                        url: '@Url.Action("BindByVerifyCode", "User", new { area = "Admin" })',
                        type: 'POST',
                        data: { account: m, code: code },
                        dataType: 'json'
                    }).done(function (d) {
                        if (d && d.code == 0) { alert('手机号绑定成功'); location.reload(); }
                        else { alert((d && d.message) || '绑定失败'); }
                    }).fail(function () { alert('绑定失败，请稍后重试'); });
                });

                // ========== 更换邮箱（验证码绑定） ==========
                $('#sec_mail_toggle').on('click', function () { $('#sec_mail_edit').toggle(); });
                $('#sec_mail_send').on('click', function () {
                    var m = $('#sec_mail_new').val();
                    if (!m || !/^[\w.+-]+@@[\w-]+(\.[\w-]+)+$/.test(m)) { alert('请输入正确的邮箱'); return; }
                    $.ajax({
                        url: '@Url.Action("SendVerifyCode", "User", new { area = "Admin" })',
                        type: 'POST',
                        data: { channel: 'Mail', username: m, action: 'Bind' },
                        dataType: 'json'
                    }).done(function (d) {
                        if (d && d.code == 0) { $('#sec_mail_code').show(); } else { alert((d && d.message) || '发送失败'); }
                    }).fail(function () { alert('发送失败，请稍后重试'); });
                });
                $('#sec_mail_confirm').on('click', function () {
                    var m = $('#sec_mail_new').val();
                    var code = $('#sec_mail_code_input').val();
                    if (!m) { alert('请输入邮箱'); return; }
                    if (!code) { alert('请输入验证码'); return; }
                    $.ajax({
                        url: '@Url.Action("BindByVerifyCode", "User", new { area = "Admin" })',
                        type: 'POST',
                        data: { account: m, code: code },
                        dataType: 'json'
                    }).done(function (d) {
                        if (d && d.code == 0) { alert('邮箱绑定成功'); location.reload(); }
                        else { alert((d && d.message) || '绑定失败'); }
                    }).fail(function () { alert('绑定失败，请稍后重试'); });
                });

                // ========== 注销账号 ==========
                $('#sec_close_btn').on('click', function () {
                    if (!confirm('确定要注销账号吗？注销后账号将被禁用，个性化数据将清空且不可恢复。')) return;
                    $.ajax({
                        url: '@Url.Action("CloseAccount", "User", new { area = "Admin" })',
                        type: 'POST',
                        dataType: 'json'
                    }).done(function (d) {
                        if (d && d.code == 0) { alert('账号已注销'); location.href = '@Url.Action("Login", "User", new { area = "Admin" })'; }
                        else { alert((d && d.message) || '注销失败'); }
                    }).fail(function () { alert('注销失败，请稍后重试'); });
                });
            });
        }
        init();
    })();
</script>
</div>