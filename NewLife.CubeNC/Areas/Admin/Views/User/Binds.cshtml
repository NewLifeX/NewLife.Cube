@model BindsModel
@using System.Linq
@using System.Reflection
@using XCode
@using XCode.Configuration
@using NewLife.Cube.Entity;
@using NewLife.Cube.Areas.Admin.Models;
@using NewLife.Cube.Web;
@{
    var ms = Model.OAuthItems;
    var binds = Model.Connects;

    // 已绑定平台数
    var boundCount = ms.Count(mi => binds.Any(e => e.Enable && e.Provider.EqualIgnoreCase(mi.Name)));
}
<div class="profile-wrap">
    @await Html.PartialAsync("_User_Nav")

    <div class="form-section">
    <div class="form-section-title">
        <i class="fa fa-plug"></i>@L.T("Third-party authorization")
        @if (ms.Count > 0)
        {
            <span class="label label-success" style="margin-left: 8px;"><i class="fa fa-link"></i> @String.Format(L.T("Bound to {0} platforms"), boundCount)</span>
        }
    </div>
    <div class="form-section-body">
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4">@L.T("Name")</label>
                    <div class="col-sm-8">
                        <input value="@Model.Name" class="form-control" disabled="disabled" />
                        <span class="help-text">@L.T("After binding a third-party platform, you can sign in with one click using that account")</span>
                    </div>
                </div>
            </div>
        </div>
        @if (ms.Count > 0)
        {
            <div class="row">
                <div class="col-sm-8 col-sm-offset-4" style="padding-left: 15px; padding-right: 15px;">
                    <ul class="oauth-list">
                        @foreach (var mi in ms)
                        {
                            var uc = binds.FirstOrDefault(e => e.Enable && e.Provider.EqualIgnoreCase(mi.Name));
                            var nickName = !mi.NickName.IsNullOrEmpty() ? mi.NickName : mi.Name;
                            var logo = !mi.Logo.IsNullOrEmpty() ? mi.Logo : ViewHelper.GetLogo(mi.Name);
                            if (uc != null)
                            {
                                <li>
                                    <span class="oauth-logo">
                                        @if (!logo.IsNullOrEmpty())
                                        {
                                            <img src="@logo" alt="@nickName" />
                                        }
                                        else
                                        {
                                            <i class="fa fa-share-alt"></i>
                                        }
                                    </span>
                                    <span class="oauth-name">
                                        @nickName
                                        <span class="oauth-nick"><i class="fa fa-user-o"></i> @(uc.NickName ?? uc.UserName) · @L.T("Bound at") @uc.CreateTime.ToFullString("yyyy-MM-dd")</span>
                                    </span>
                                    <span class="label label-success oauth-status"><i class="fa fa-check"></i> @L.T("Bound")</span>
                                    <a href="~/Sso/UnBind/@mi.Name" class="btn btn-danger btn-sm oauth-action" title="@L.T("Unbind") @nickName" onclick="return confirm('@L.T("Unbind this account?")');"><i class="fa fa-unlink"></i> @L.T("Unbind")</a>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <span class="oauth-logo">
                                        @if (!logo.IsNullOrEmpty())
                                        {
                                            <img src="@logo" alt="@nickName" />
                                        }
                                        else
                                        {
                                            <i class="fa fa-share-alt"></i>
                                        }
                                    </span>
                                    <span class="oauth-name">@nickName</span>
                                    <span class="label label-default oauth-status"><i class="fa fa-circle-o"></i> @L.T("Not bound")</span>
                                    <a href="~/Sso/Bind/@mi.Name" target="_blank" class="btn btn-primary btn-sm oauth-action" title="@L.T("Bind") @nickName"><i class="fa fa-link"></i> @L.T("Bind now")</a>
                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>
        }
        else
        {
            <div class="text-center" style="color: #999; padding: 20px 0;">
                <i class="fa fa-info-circle"></i> @L.T("No third-party sign-in platform available; configure it in Cube settings → OAuth settings")
            </div>
        }
    </div>
</div>
</div>