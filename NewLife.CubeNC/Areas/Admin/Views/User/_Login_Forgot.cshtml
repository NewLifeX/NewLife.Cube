@model LoginViewModel
@using NewLife.Common
@{
    var set = Model;
}
<div class="tab-pane fade" id="Forgot">
    <!-- 登录-->
    @using (Html.BeginForm("ForgetPassword", "User", new { r = set.ReturnUrl }, FormMethod.Post, true, new { @class = "cube-login" }))
    {
        @Html.ValidationSummary()
        <div class="form-group">
            <div class="input-icon">
                <i class="glyphicon glyphicon-envelope"></i>
                <input type="email" class="form-control" id="email" name="email" placeholder="输入你的邮箱地址" autocomplete="email">
            </div>
        </div>
        <button type="submit" class="btn-login">发送重置邮件</button>
    }
</div>