@model LoginViewModel
@using NewLife.Common
@{
    var set = Model;
    //var returnUrl = (String)ViewBag.ReturnUrl;
    //var url = Url.Action("Register", "User", new { r = returnUrl });
}
<div class="tab-pane fade" id="Register">
    <!-- 登录-->
    <form action="@Url.Action("Register", "User", new { r = set.ReturnUrl })" class="cube-login" method="post" id="cube-register">
        @Html.ValidationSummary()
        <div class="form-group">
            <div class="input-icon">
                <i class="glyphicon glyphicon-user"></i>
                <input type="text" class="form-control" id="reg_username" name="username" placeholder="用户名" required="required" autocomplete="username">
            </div>
        </div>
        <div class="form-group">
            <div class="input-icon">
                <i class="glyphicon glyphicon-envelope"></i>
                <input type="email" class="form-control" id="reg_email" name="email" placeholder="邮箱（选填）" autocomplete="email">
            </div>
        </div>
        <div class="form-group">
            <div class="input-icon">
                <i class="glyphicon glyphicon-phone"></i>
                <input type="tel" class="form-control" id="reg_mobile" name="mobile" placeholder="手机号（选填）" maxlength="11" autocomplete="tel">
            </div>
        </div>
        <div class="form-group">
            <div class="input-icon">
                <i class="glyphicon glyphicon-lock"></i>
                <input type="password" class="form-control has-toggle" id="reg_password" name="password" placeholder="密码" autocomplete="off">
                <span class="pwd-toggle" data-target="reg_password" title="显示/隐藏密码"><i class="glyphicon glyphicon-eye-open"></i></span>
            </div>
        </div>
        <div class="form-group">
            <div class="input-icon">
                <i class="glyphicon glyphicon-lock"></i>
                <input type="password" class="form-control" id="reg_password2" name="password2" placeholder="重复密码" autocomplete="off">
            </div>
        </div>
        <p class="form-tip">用户名必填，邮箱或手机至少填写一项</p>
        <button type="submit" class="btn-login">注 册</button>
    </form>
</div>