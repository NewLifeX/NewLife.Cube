@model LoginViewModel
@using NewLife.Common;
@{
    Layout = null;
    ViewBag.Title = "登录";

    var res = Model.ResourceUrl;
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- 上述3个meta标签*必须*放在最前面，任何其他内容都*必须*跟随其后！ -->

    <title>@ViewBag.Title - @SysConfig.Current.DisplayName</title>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <!-- 基本样式 -->
    <link href="@res/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <!-- 自定义样式-->
    <link href="@res/Cube.css" rel="stylesheet" />
    <!-- 登录页样式 -->
    <style>
        /* ========== 登录页设计语言：延续 ACE 主题主色 #2b7dbc ========== */
        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: "Microsoft YaHei", "PingFang SC", "Helvetica Neue", Arial, sans-serif;
            color: #3a3f44;
            background: linear-gradient(160deg, #eef4fb 0%, #f0f2f5 45%, #e8eef6 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 24px 16px;
        }

        /* 登录提示条（对应 LoginTip） */
        .login-tip {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            background: #fff8e6;
            border-bottom: 1px solid #f0e3b5;
            color: #8a6d3b;
            font-size: 13px;
            line-height: 40px;
            text-align: center;
            padding: 0 48px;
        }
        .login-tip .close-tip {
            position: absolute;
            right: 16px;
            top: 0;
            color: #b8a25e;
            cursor: pointer;
            font-size: 16px;
        }

        .login-wrapper { width: 100%; max-width: 440px; margin: 0 auto; }

        /* ========== 登录卡片 ========== */
        .login-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 8px 30px rgba(43, 125, 188, .12), 0 2px 8px rgba(0, 0, 0, .06);
            overflow: hidden;
        }

        /* 品牌区 */
        .brand {
            padding: 34px 32px 10px;
            text-align: center;
        }
        .brand-logo {
            width: 64px;
            height: 64px;
            margin: 0 auto 12px;
            border-radius: 16px;
            background: linear-gradient(135deg, #2b7dbc, #1f5f8e);
            color: #fff;
            font-size: 34px;
            line-height: 64px;
            text-align: center;
            box-shadow: 0 4px 12px rgba(43, 125, 188, .35);
            overflow: hidden;
        }
        .brand-logo img { width: 100%; height: 100%; }
        .brand h1 {
            font-size: 20px;
            font-weight: 700;
            margin: 0;
            color: #262a2e;
        }
        .brand p {
            margin: 4px 0 0;
            font-size: 12px;
            color: #999;
        }

        /* ========== Tab 切换 ========== */
        .login-tabs {
            display: flex;
            margin: 22px 40px 0;
            border-bottom: 1px solid #eef1f4;
        }
        .login-tabs a {
            flex: 1;
            text-align: center;
            padding: 10px 0;
            font-size: 14px;
            color: #7a8087;
            text-decoration: none;
            border-bottom: 2px solid transparent;
            margin-bottom: -1px;
            transition: color .2s, border-color .2s;
            cursor: pointer;
        }
        .login-tabs a:hover { color: #2b7dbc; }
        .login-tabs a.active {
            color: #2b7dbc;
            font-weight: 700;
            border-bottom-color: #2b7dbc;
        }

        /* ========== 面板 ========== */
        /* 底部保留内边距，避免注册/忘记密码提交按钮紧贴卡片下沿 */
        .tab-content .tab-pane { display: none; padding: 24px 40px 28px; }
        .tab-content .tab-pane.active { display: block; }

        /* 输入框：左侧图标 + 圆角 */
        .cube-login .form-group { margin-bottom: 18px; position: relative; }
        .input-icon { position: relative; }
        .input-icon > i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #a8b3bf;
            font-size: 15px;
            transition: color .2s;
            pointer-events: none;
            z-index: 2;
        }
        .input-icon .form-control {
            width: 100%;
            height: 44px;
            padding: 0 42px 0 40px;
            border: 1px solid #dde3ea;
            border-radius: 8px;
            font-size: 14px;
            color: #3a3f44;
            background: #fafbfc;
            outline: none;
            box-shadow: none;
            transition: border-color .2s, box-shadow .2s, background .2s;
        }
        .input-icon .form-control:focus {
            border-color: #2b7dbc;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(43, 125, 188, .12);
        }
        .input-icon .form-control::placeholder { color: #b0b8c2; }

        /* 密码可见切换 */
        .pwd-toggle {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #a8b3bf;
            cursor: pointer;
            font-size: 15px;
            padding: 4px;
            z-index: 2;
        }
        .pwd-toggle:hover { color: #2b7dbc; }
        .input-icon .form-control.has-toggle { padding-right: 40px; }

        /* 记住我 + 忘记密码 */
        .form-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            font-size: 13px;
        }
        .checkbox-custom {
            display: inline-flex;
            align-items: center;
            color: #6a6f75;
            cursor: pointer;
            user-select: none;
            margin: 0;
        }
        .checkbox-custom input { display: none; }
        .checkbox-custom .box {
            width: 16px;
            height: 16px;
            border: 1px solid #c6ced8;
            border-radius: 4px;
            margin-right: 6px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            color: #fff;
            background: #fff;
            transition: all .2s;
        }
        .checkbox-custom input:checked + .box {
            background: #2b7dbc;
            border-color: #2b7dbc;
        }
        .checkbox-custom input:checked + .box:after {
            content: "\e013";
            font-family: "Glyphicons Halflings";
        }
        .forgot-link {
            color: #2b7dbc;
            text-decoration: none;
            cursor: pointer;
        }
        .forgot-link:hover { text-decoration: underline; }

        /* 主按钮 */
        .btn-login {
            width: 100%;
            height: 44px;
            border: none;
            border-radius: 8px;
            background: linear-gradient(135deg, #2b7dbc, #1f5f8e);
            color: #fff;
            font-size: 15px;
            font-weight: 600;
            letter-spacing: 2px;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(43, 125, 188, .3);
            transition: all .2s;
            display: inline-block;
            line-height: 44px;
            text-align: center;
            text-decoration: none;
        }
        .btn-login:hover {
            box-shadow: 0 6px 16px rgba(43, 125, 188, .42);
            transform: translateY(-1px);
            color: #fff;
        }
        .btn-login:active { transform: translateY(0); }

        /* 表单提示 */
        .form-tip {
            font-size: 12px;
            color: #999;
            text-align: center;
            margin: -6px 0 14px;
        }

        /* ========== 注册方式子 Tab（用户名/手机/邮箱） ========== */
        .reg-modes {
            display: flex;
            margin: 0 -40px 18px;
            padding: 0 40px;
            border-bottom: 1px solid #eef1f4;
        }
        .reg-modes a {
            flex: 1;
            text-align: center;
            padding: 8px 0 10px;
            font-size: 13px;
            color: #7a8087;
            text-decoration: none;
            border-bottom: 2px solid transparent;
            margin-bottom: -1px;
            transition: color .2s, border-color .2s;
            cursor: pointer;
        }
        .reg-modes a:hover { color: #2b7dbc; }
        .reg-modes a.active {
            color: #2b7dbc;
            font-weight: 700;
            border-bottom-color: #2b7dbc;
        }
        .reg-form { display: none; }
        .reg-form.active { display: block; }

        /* ========== 登录方式子 Tab（密码/手机/邮箱） ========== */
        .login-modes {
            display: flex;
            margin: 0 -40px 18px;
            padding: 0 40px;
            border-bottom: 1px solid #eef1f4;
        }
        .login-modes a {
            flex: 1;
            text-align: center;
            padding: 8px 0 10px;
            font-size: 13px;
            color: #7a8087;
            text-decoration: none;
            border-bottom: 2px solid transparent;
            margin-bottom: -1px;
            transition: color .2s, border-color .2s;
            cursor: pointer;
        }
        .login-modes a:hover { color: #2b7dbc; }
        .login-modes a.active {
            color: #2b7dbc;
            font-weight: 700;
            border-bottom-color: #2b7dbc;
        }
        .login-form { display: none; }
        .login-form.active { display: block; }

        /* 发送验证码按钮（手机/邮箱注册、忘记密码共用） */
        .input-group { display: flex; gap: 8px; }
        .input-group .input-icon { flex: 1; }
        .btn-code {
            width: 116px;
            height: 44px;
            flex: none;
            border: 1px solid #2b7dbc;
            border-radius: 8px;
            background: #fff;
            color: #2b7dbc;
            font-size: 13px;
            cursor: pointer;
            transition: all .2s;
            white-space: nowrap;
        }
        .btn-code:hover { background: #eef4fb; }
        .btn-code:disabled { opacity: .5; cursor: not-allowed; }

        /* 密码强度 / 字段校验提示 */
        .field-tip {
            font-size: 12px;
            line-height: 1.6;
            margin: 6px 0 0;
            display: none;
        }
        .field-tip.show { display: block; }
        .field-tip.ok { color: #3aa76d; }
        .field-tip.error { color: #e14b4b; }
        .input-icon input.error { border-color: #e14b4b; }
        .input-icon input.ok { border-color: #3aa76d; }

        /* ========== 第三方登录 ========== */
        .third-party { padding: 22px 40px 30px; }
        .divider {
            display: flex;
            align-items: center;
            color: #b0b8c2;
            font-size: 12px;
            margin-bottom: 18px;
        }
        .divider:before, .divider:after {
            content: "";
            flex: 1;
            height: 1px;
            background: #eef1f4;
        }
        .divider span { padding: 0 14px; }

        .oauth-icons {
            display: flex;
            justify-content: center;
            gap: 18px;
            flex-wrap: wrap;
        }
        .oauth-icon {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #f0f2f5;
            overflow: hidden;
            box-shadow: 0 2px 6px rgba(0, 0, 0, .12);
            transition: transform .2s, box-shadow .2s;
        }
        .oauth-icon:hover {
            transform: translateY(-3px) scale(1.06);
            box-shadow: 0 6px 14px rgba(0, 0, 0, .18);
        }
        .oauth-icon img { width: 100%; height: 100%; }
        .oauth-icon i { color: #7a8087; font-size: 18px; }

        /* ========== 页脚 ========== */
        .login-footer {
            text-align: center;
            margin-top: 18px;
            font-size: 12px;
            color: #9aa5b1;
        }

        /* ========== 响应式 ========== */
        @@media (max-width: 480px) {
            .tab-content .tab-pane { padding: 20px 24px 24px; }
            .third-party { padding: 18px 24px 24px; }
            .brand { padding: 28px 20px 6px; }
            .login-tabs { margin: 18px 24px 0; }
            .reg-modes { margin: 0 -24px 16px; padding: 0 24px; }
            .login-modes { margin: 0 -24px 16px; padding: 0 24px; }
            .oauth-icons { gap: 12px; }
            .login-tip { padding: 0 40px; line-height: 34px; font-size: 12px; }
        }

        /* ========== 图片验证码 ========== */
        .captcha-row .captcha-img {
            width: 110px;
            height: 44px;
            flex: none;
            border: 1px solid #dde3ea;
            border-radius: 8px;
            background: #fafbfc;
            cursor: pointer;
            object-fit: cover;
        }
    </style>
</head>
<body>
    <!-- 登录提示条（对应 LoginTip，可关闭） -->
    @if (!Model.LoginTip.IsNullOrEmpty())
    {
        <div class="login-tip" id="loginTip">
            @Html.Raw(Model.LoginTip)
            <span class="close-tip" onclick="document.getElementById('loginTip').style.display='none'">&times;</span>
        </div>
    }

    <div class="login-wrapper">
        <div class="login-card">
            <!-- 品牌区 -->
            <div class="brand">
                <div class="brand-logo">
                    @if (!Model.Logo.IsNullOrEmpty())
                    {
                        <img src="@Model.Logo" alt="@Model.DisplayName" />
                    }
                    else
                    {
                        <i class="glyphicon glyphicon-cloud"></i>
                    }
                </div>
                <h1>@Model.DisplayName</h1>
                <p>登录后即可访问管理后台</p>
            </div>

            <!-- Tab 切换：登录 / 注册 / 忘记密码 -->
            <div class="login-tabs">
                <a class="active" data-tab="Login">登录</a>
                @if (Model.AllowRegister)
                {
                    <a data-tab="Register">注册</a>
                }
                <a data-tab="Forgot">忘记密码</a>
            </div>

            <!-- 面板 -->
            <div class="tab-content">
                @await Html.PartialAsync("_Login_Login", Model)@*登录页*@
                @await Html.PartialAsync("_Login_Forgot", Model)@*找回密码页*@
                @await Html.PartialAsync("_Login_Register", Model)@*注册页*@
            </div>

            <!-- 第三方登录（仅登录面板显示） -->
            <div id="thirdParty">
                @await Html.PartialAsync("_Login_Login3", Model)@*第三方登录*@
            </div>
        </div>

        <!-- 页脚（由 _Footer 提供） -->
    </div>

    <!-- JQuery作为一等公民，页面内部随时可能使用 -->
    <script src="@res/js/jquery-3.6.0.min.js"></script>
    <script src="@res/bootstrap/js/bootstrap.min.js"></script>
    <!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
    <!--[if lt IE 9]>
      <script src="https://cdn.bootcss.com/html5shiv/3.7.3/html5shiv.min.js"></script>
      <script src="https://cdn.bootcss.com/respond.js/1.4.2/respond.min.js"></script>
    <![endif]-->
    <script src="@res/js/md5.js"></script>
    <script src="@res/js/jsencrypt.min.js"></script>

    <script>
        $(function () {
            // ========== 图片验证码（登录/注册/忘记密码/发码，动态注入表单） ==========
            var captchaApi = '@Url.Action("Captcha", "User", new { area = "Admin" })';
            var loginCaptcha = @Html.Raw(Json.Serialize(Model.RequireCaptcha));
            var registerCaptcha = @Html.Raw(Json.Serialize(Model.RequireCaptchaRegister));
            window.CubeCaptcha = {
                // 加载验证码图片到指定验证码行
                load: function (row) {
                    var $row = $(row);
                    $.getJSON(captchaApi, function (data) {
                        if (data && data.code == 0 && data.data) {
                            $row.find('[data-captcha-img]').attr('src', data.data.image);
                            $row.find('[data-captcha-id]').val(data.data.captchaId);
                            $row.find('[data-captcha-input]').val('');
                        }
                    });
                },
                // 显示验证码行并加载图片
                show: function (row) {
                    var $row = $(row);
                    if (!$row.length) return;
                    $row.show();
                    if (!$row.find('[data-captcha-id]').val()) CubeCaptcha.load($row);
                },
                // 表单可见验证码校验并填充 hidden 字段；通过返回 true
                fill: function (form) {
                    var $row = $(form).find('[data-captcha]');
                    if (!$row.length || !$row.is(':visible')) return true;
                    var code = $row.find('[data-captcha-input]').val();
                    if (!code) { alert('请输入图形验证码'); return false; }
                    $row.find('[data-captcha-code]').val(code);
                    return true;
                }
            };
            // 为表单注入验证码行（幂等）
            function ensureCaptchaRow($form) {
                if ($form.find('[data-captcha]').length) return $form.find('[data-captcha]');
                var $row = $(
                    '<div class="form-group captcha-row" data-captcha style="display:none;">' +
                    '<div class="input-group">' +
                    '<div class="input-icon">' +
                    '<i class="glyphicon glyphicon-picture"></i>' +
                    '<input type="text" class="form-control" data-captcha-input placeholder="图形验证码" autocomplete="off" />' +
                    '</div>' +
                    '<img data-captcha-img class="captcha-img" src="" alt="验证码" title="点击刷新" />' +
                    '</div>' +
                    '<input type="hidden" data-captcha-id name="captchaId" />' +
                    '<input type="hidden" data-captcha-code name="captchaCode" />' +
                    '</div>'
                );
                $form.append($row);
                return $row;
            }
            // 点击验证码图片刷新
            $(document).on('click', '[data-captcha-img]', function () {
                CubeCaptcha.load($(this).closest('[data-captcha]'));
            });
            // 表单提交前校验图形验证码（登录/注册/忘记密码）
            $(document).on('submit', '.cube-login', function () {
                return CubeCaptcha.fill(this);
            });
            // 初始按服务端判定显示验证码（CaptchaScene 强制 或 风险自适应）
            if (loginCaptcha) {
                $('#Login .cube-login').each(function () { CubeCaptcha.show(ensureCaptchaRow($(this))); });
            }
            if (registerCaptcha) {
                $('#Register .cube-login').each(function () { CubeCaptcha.show(ensureCaptchaRow($(this))); });
            }
            // 忘记密码表单预留验证码行（发码被拒后动态显示）
            ensureCaptchaRow($('#cube-forgot-step1'));

            // ========== Tab 切换（登录/注册/忘记密码） ==========
            $('.login-tabs a, [data-tab-link]').on('click', function () {
                var tab = $(this).data('tab') || $(this).data('tab-link');
                $('.login-tabs a').removeClass('active')
                    .filter('[data-tab="' + tab + '"]').addClass('active');
                $('.tab-content .tab-pane').removeClass('active')
                    .filter('#' + tab).addClass('active');

                // 第三方登录只在登录面板显示
                $('#thirdParty').toggle(tab === 'Login');
            });

            // ========== 密码可见切换 ==========
            $('.pwd-toggle').on('click', function () {
                var target = $('#' + $(this).data('target'));
                var isPwd = target.attr('type') === 'password';
                target.attr('type', isPwd ? 'text' : 'password');
                $(this).find('i').toggleClass('glyphicon-eye-open glyphicon-eye-close');
            });

            // ========== 登录方式子 Tab 切换（密码/手机/邮箱） ==========
            $('.login-modes a').on('click', function () {
                var tab = $(this).data('login-tab');
                $('.login-modes a').removeClass('active')
                    .filter('[data-login-tab="' + tab + '"]').addClass('active');
                $('.login-form').removeClass('active')
                    .filter('#' + tab).addClass('active');
            });

            // ========== 发送验证码（登录场景 action=Login，手机走短信、邮箱走邮件） ==========
            function startLoginCountdown(btn) {
                var sec = 60;
                btn.prop('disabled', true);
                var timer = setInterval(function () {
                    sec--;
                    btn.text(sec + 's 后重发');
                    if (sec <= 0) {
                        clearInterval(timer);
                        btn.prop('disabled', false).text('发送验证码');
                    }
                }, 1000);
            }
            $('[data-login-send]').on('click', function () {
                var btn = $(this);
                var account = $('#' + btn.data('login-send')).val();
                var channel = btn.data('channel');
                if (!account) {
                    alert('请先输入' + (channel === 'Sms' ? '手机号' : '邮箱'));
                    return;
                }
                var form = btn.closest('form');
                // 验证码行可见时须先填写图形验证码（发码场景防短信轰炸）
                if (typeof CubeCaptcha !== 'undefined' && !CubeCaptcha.fill(form)) return;
                $.ajax({
                    url: '@Url.Action("SendVerifyCode", "User", new { area = "Admin" })',
                    type: 'POST',
                    data: {
                        channel: channel, username: account, action: 'Login',
                        captchaId: form.find('[data-captcha-id]').val(),
                        captchaCode: form.find('[data-captcha-code]').val()
                    },
                    dataType: 'json'
                }).done(function (data) {
                    if (data && data.code == 0) {
                        startLoginCountdown(btn);
                    } else {
                        // 服务端要求验证码时，显示验证码行并刷新
                        if (typeof CubeCaptcha !== 'undefined' && data && data.message && data.message.indexOf('验证码') >= 0)
                            CubeCaptcha.show(form.find('[data-captcha]'));
                        alert((data && data.message) || '验证码发送失败');
                    }
                }).fail(function () {
                    alert('验证码发送失败，请稍后重试');
                });
            });

            // ========== 登录：保留 RSA 非对称加密 ==========
            // 在用户名和密码框按回车时触发登录
            $("#username, #password").keydown(function (e) {
                if (e.key === 'Enter' || e.keyCode === 13) {
                    $("#login-btn").click();
                }
            });

            // 提交前动态获取新鲜 RSA 密钥，避免页面停留过久导致密钥过期
            // 对齐 WebAPI 版 GET /Auth/Challenge 语义
            function fetchLoginKey() {
                return $.ajax({
                    url: '@Url.Action("GetLoginKey", "User", new { area = "Admin" })',
                    type: 'GET',
                    dataType: 'json'
                });
            }

            $("#login-btn").click(function () {
                var username = $("#username").val();
                var password = $("#password").val();

                if (username == '') {
                    alert('请输入用户名');
                    return;
                }
                if (password == '') {
                    alert('请输入密码');
                    return;
                }

                var btn = $(this);
                btn.prop('disabled', true);

                // 先获取新密钥，成功则用新公钥加密；失败降级为页面初始公钥
                fetchLoginKey().done(function (data) {
                    if (data && data.code == 0 && data.data) {
                        $('#challenge_id_container').val(data.data.publicKey);
                        $('input[name="challengeId"]').val(data.data.challengeId);
                    }
                    submitLogin(password, btn);
                }).fail(function () {
                    submitLogin(password, btn);
                });
            });

            function submitLogin(password, btn) {
                var challengeId = $('#challenge_id_container').val();

                if (challengeId && challengeId.length > 0) {
                    var resultPWD = encryptPwd(password);
                    $('#pwd').val(resultPWD);
                } else {
                    $('#pwd').val(password);
                }

                $("#login-pwd").submit();
            }

            function encryptPwd(p) {
                var rsa = new JSEncrypt();
                rsa.setPublicKey($('#challenge_id_container').val());

                return rsa.encrypt(p);
            }
        });
    </script>
</body>
@await Html.PartialAsync("_Footer")
</html>