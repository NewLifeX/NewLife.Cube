@model LoginViewModel
@using NewLife.Common;
@{
    Layout = null;
    ViewBag.Title = "登录";

    var res = Model.ResourceUrl;
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- 上述3个meta标签*必须*放在最前面，任何其他内容都*必须*跟随其后！ -->

    <title>@ViewBag.Title - @SysConfig.Current.DisplayName</title>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <!-- 基本样式 -->
    <link href="@res/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <!-- 自定义样式-->
    <link href="@res/Cube.css" rel="stylesheet" />
    <!-- 登录页样式（独立 css，避免与 Cube.css 旧 .cube-login 样式冲突） -->
    <link href="@res/cube-login.css" rel="stylesheet" />
    <!-- 图标：FontAwesome（本地） -->
    <link href="@res/bootstrap/css/font-awesome.min.css" rel="stylesheet" />
</head>
<body>
    <!-- 登录提示条（对应 LoginTip，可关闭） -->
    @if (!Model.LoginTip.IsNullOrEmpty())
    {
        <div class="login-tip" id="loginTip">
            @Html.Raw(Model.LoginTip)
            <span class="close-tip" onclick="document.getElementById('loginTip').style.display='none'">&times;</span>
        </div>
    }

    <div class="login-wrapper">
        <div class="login-card">
            <!-- 品牌区 -->
            <div class="brand">
                <div class="brand-logo">
                    @if (!Model.Logo.IsNullOrEmpty())
                    {
                        <img src="@Model.Logo" alt="@Model.DisplayName" />
                    }
                    else
                    {
                        <i class="fa fa-cloud"></i>
                    }
                </div>
                <h1>@Model.DisplayName</h1>
                <p>登录后即可访问管理后台</p>
            </div>

            <!-- Tab 切换：登录 / 注册 -->
            <div class="login-tabs">
                <a class="active" data-tab="Login">登录</a>
                @if (Model.AllowRegister)
                {
                    <a data-tab="Register">注册</a>
                }
            </div>

            <!-- 面板 -->
            <div class="tab-content">
                @await Html.PartialAsync("_Login_Login", Model)@*登录页*@
                @await Html.PartialAsync("_Login_Register", Model)@*注册页*@
            </div>

            <!-- 第三方登录（仅登录面板显示） -->
            <div id="thirdParty">
                @await Html.PartialAsync("_Login_Login3", Model)@*第三方登录*@
            </div>
        </div>

        <!-- 页脚（由 _Footer 提供） -->
    </div>

    <!-- JQuery作为一等公民，页面内部随时可能使用 -->
    <script src="@res/js/jquery-3.6.0.min.js"></script>
    <script src="@res/bootstrap/js/bootstrap.min.js"></script>
    <!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
    <!--[if lt IE 9]>
      <script src="https://cdn.bootcss.com/html5shiv/3.7.3/html5shiv.min.js"></script>
      <script src="https://cdn.bootcss.com/respond.js/1.4.2/respond.min.js"></script>
    <![endif]-->
    <script src="@res/js/md5.js"></script>
    <script src="@res/js/jsencrypt.min.js"></script>

    <script>
        $(function () {
            // ========== Tab 切换（登录/注册） ==========
            $('.login-tabs a, [data-tab-link]').on('click', function () {
                var tab = $(this).data('tab') || $(this).data('tab-link');
                $('.login-tabs a').removeClass('active')
                    .filter('[data-tab="' + tab + '"]').addClass('active');
                $('.tab-content .tab-pane').removeClass('active')
                    .filter('#' + tab).addClass('active');

                // 第三方登录只在登录面板显示
                $('#thirdParty').toggle(tab === 'Login');
            });

            // ========== 密码可见切换 ==========
            $('.pwd-toggle').on('click', function () {
                var target = $('#' + $(this).data('target'));
                var isPwd = target.attr('type') === 'password';
                target.attr('type', isPwd ? 'text' : 'password');
                $(this).find('i').toggleClass('fa-eye fa-eye-slash');
            });

            // ========== 登录：保留 RSA 非对称加密 ==========
            // 在用户名和密码框按回车时触发登录
            $("#username, #password").keydown(function (e) {
                if (e.key === 'Enter' || e.keyCode === 13) {
                    $("#login-btn").click();
                }
            });

            // 提交前动态获取新鲜 RSA 密钥，避免页面停留过久导致密钥过期
            // 对齐 WebAPI 版 GET /Auth/Challenge 语义
            function fetchLoginKey() {
                return $.ajax({
                    url: '@Url.Action("GetLoginKey", "User", new { area = "Admin" })',
                    type: 'GET',
                    dataType: 'json'
                });
            }

            $("#login-btn").click(function () {
                var username = $("#username").val();
                var password = $("#password").val();

                if (username == '') {
                    alert('请输入用户名');
                    return;
                }
                if (password == '') {
                    alert('请输入密码');
                    return;
                }

                var btn = $(this);
                btn.prop('disabled', true);

                // 先获取新密钥，成功则用新公钥加密；失败降级为页面初始公钥
                fetchLoginKey().done(function (data) {
                    if (data && data.code == 0 && data.data) {
                        $('#challenge_id_container').val(data.data.publicKey);
                        $('input[name="challengeId"]').val(data.data.challengeId);
                    }
                    submitLogin(password, btn);
                }).fail(function () {
                    submitLogin(password, btn);
                });
            });

            function submitLogin(password, btn) {
                var challengeId = $('#challenge_id_container').val();

                if (challengeId && challengeId.length > 0) {
                    var resultPWD = encryptPwd(password);
                    $('#pwd').val(resultPWD);
                } else {
                    $('#pwd').val(password);
                }

                $("#login-pwd").submit();
            }

            function encryptPwd(p) {
                var rsa = new JSEncrypt();
                rsa.setPublicKey($('#challenge_id_container').val());

                return rsa.encrypt(p);
            }
        });
    </script>
</body>
@await Html.PartialAsync("_Footer")
</html>
