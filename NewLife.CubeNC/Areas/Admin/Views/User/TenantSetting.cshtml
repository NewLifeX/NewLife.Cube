@model TenantSettingModel
@using System.Linq
@using System.Reflection
@using XCode
@using XCode.Configuration
@using NewLife.Cube.Entity;
@using NewLife.Cube.Areas.Admin.Models;
@{
    var atts = HtmlHelper.AnonymousObjectToHtmlAttributes(null);
    atts.Add("class", "multiselect form-control");
    atts.Add("id", "Tenants");

    var tenantId = ViewData["TenantId"]?.ToInt();
}
<div class="profile-wrap">
    @await Html.PartialAsync("_User_Nav")

    @using (Html.BeginForm("TenantSetting", "User", null, FormMethod.Post, null, new { @class = "form-horizontal" }))
{
    <div class="form-section">
        <div class="form-section-title"><i class="fa fa-building-o"></i>租户信息</div>
        <div class="form-section-body">
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-sm-4">用户名</label>
                        <div class="col-sm-8">
                            <input value="@Model.UserName" class="form-control" disabled="disabled" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-sm-4">当前租户</label>
                        <div class="col-sm-8">
                            @Html.DropDownList("TagTenantId", new SelectList(Model.Tenants, "Key", "Value", tenantId), "请选择", atts)
                            <span class="help-text">切换后仅显示该租户下的数据</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="profile-actions">
        <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> 保存</button>
        <button type="button" class="btn btn-default" onclick="history.go(-1);"><i class="fa fa-times"></i> 取消</button>
    </div>
}
</div>