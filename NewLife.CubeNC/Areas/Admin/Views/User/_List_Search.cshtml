@using NewLife;
@using NewLife.Web;
@using XCode;
@{
    var fact = ViewBag.Factory as IEntityFactory;
    var page = ViewBag.Page as Pager;
}
@Html.ActionLink(L.T("Online users"), "Index", "UserOnline", null, new { target = "_blank", @class = "toolbar-link" })
@Html.ActionLink(L.T("User statistics"), "Index", "UserStat", null, new { target = "_blank", @class = "toolbar-link" })
<div class="form-group">
    <label for="roleIds" class="control-label">@L.T("Role:")</label>
    @await Html.PartialAsync("_Form_ListBox", new ListBoxModel("roleIds", Role.FindAllWithCache().OrderByDescending(e => e.Sort).ToList(), page["roleIds"]))
</div>
@await Html.PartialAsync("_Enable")
@await Html.PartialAsync("_SelectDepartment", "departmentId")
@await Html.PartialAsync("_Area2", "")
