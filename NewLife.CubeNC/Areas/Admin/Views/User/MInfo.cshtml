@model XCode.Membership.User
@using System.Linq
@using System.Reflection
@using XCode
@using XCode.Configuration
@using NewLife.Cube.Entity;
@{
    var fact = EntityFactory.CreateFactory(ViewData.ModelMetadata.ModelType);
    var user = Model as IUser;
    var user2 = user as User;

    // 角色徽章配色
    var roleColors = new[] { "label-primary", "label-success", "label-info", "label-warning", "label-danger" };
    var roles = user?.Roles;
    var idx = 0;
}
<div class="profile-wrap">
    @await Html.PartialAsync("_User_Nav")

    @if (ViewBag.StatusMessage != null)
{
    <div class="alert alert-success alert-dismissible text-center" role="alert">
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <strong>@ViewBag.StatusMessage</strong>
    </div>
}

<!-- 个人信息头卡 -->
<div class="profile-card">
    <div class="profile-head">
        <div class="profile-avatar">
            @if (!user.Avatar.IsNullOrEmpty())
            {
                <img src="@user.GetAvatarUrl()" alt="@L.T("Avatar")" />
            }
            else
            {
                <span class="avatar-fallback"><i class="fa fa-user"></i></span>
            }
        </div>
        <div class="profile-info">
            <div class="profile-name">
                @user.DisplayName
                <span class="profile-username"><i class="fa fa-user-o"></i> @user.Name</span>
            </div>
            <div class="profile-badges">
                @if (roles != null)
                {
                    foreach (var r in roles)
                    {
                        var cls = roleColors[idx++ % roleColors.Length];
                        <span class="label @cls">@r</span>
                    }
                }
            </div>
        </div>
    </div>
    <div class="profile-stats">
        <div class="stat-item">
            <div class="stat-num">@user.Logins</div>
            <div class="stat-label">@L.T("Sign-in count")</div>
        </div>
        <div class="stat-item">
            <div class="stat-num">@user.LastLogin.ToFullString("")</div>
            <div class="stat-label">@L.T("Last sign-in")</div>
        </div>
        <div class="stat-item">
            <div class="stat-num">@(user2?.DepartmentName)</div>
            <div class="stat-label">@L.T("Department")</div>
        </div>
        <div class="stat-item">
            <div class="stat-num">@user.LastLoginIP</div>
            <div class="stat-label">@L.T("Last sign-in IP")</div>
        </div>
    </div>
</div>

@using (Html.BeginForm("Info", null, new { id = Model[fact.Unique.Name] }, FormMethod.Post, null, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
    @Html.ValidationSummary()

    <!-- 基础信息 -->
    <div class="form-section">
        <div class="form-section-title"><i class="fa fa-id-card-o"></i>@L.T("Basic information")</div>
        <div class="form-section-body">
            <div class="form-group">
                <label class="control-label col-sm-4">@L.T("Name")</label>
                <div class="col-sm-8">
                    <input value="@user.Name" class="form-control" disabled="disabled" />
                    <span class="help-text">@L.T("Sign-in name, cannot be modified")</span>
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-sm-4">@L.T("Display name")</label>
                <div class="col-sm-8">
                    @Html.ForEditor("DisplayName")
                    @Html.ForDescription("DisplayName")
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-sm-4">@L.T("Gender")</label>
                <div class="col-sm-8">
                    @Html.ForEditor("Sex", user.Sex)
                    @Html.ForDescription("Sex")
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-sm-4">@L.T("Birthday")</label>
                <div class="col-sm-8">
                    <div class="input-group">
                        @Html.ForEditor("Birthday")
                    </div>
                    <span class="help-text">@Html.ForDescription("Birthday")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 联系方式 -->
    <div class="form-section">
        <div class="form-section-title"><i class="fa fa-envelope-o"></i>@L.T("Contact")</div>
        <div class="form-section-body">
            <div class="form-group">
                <label class="control-label col-sm-4">@L.T("Email")</label>
                <div class="col-sm-8">
                    @Html.ForEditor("Mail")
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-sm-4">@L.T("Mobile")</label>
                <div class="col-sm-8">
                    @Html.ForEditor("Mobile")
                </div>
            </div>
        </div>
    </div>

    <!-- 身份信息 -->
    <div class="form-section">
        <div class="form-section-title"><i class="fa fa-shield"></i>@L.T("Identity information")</div>
        <div class="form-section-body">
            <div class="form-group">
                <label class="control-label col-sm-4">@L.T("Code")</label>
                <div class="col-sm-8">
                    @Html.ForEditor("Code")
                    <span class="help-text">@Html.ForDescription("Code")</span>
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-sm-4">@L.T("Role")</label>
                <div class="col-sm-8">
                    <p class="form-value">
                        @if (roles != null)
                        {
                            foreach (var r in roles)
                            {
                                <span class="label label-primary">@r</span>
                            }
                        }
                    </p>
                    <span class="help-text">@L.T("Primary and secondary roles")</span>
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-sm-4">@L.T("Department")</label>
                <div class="col-sm-8">
                    <p class="form-value"><i class="fa fa-sitemap"></i>@(user2?.DepartmentName)</p>
                    <span class="help-text">@Html.ForDescription("Department")</span>
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-sm-4">@L.T("Avatar")</label>
                <div class="col-sm-8 avatar-upload">
                    <span class="avatar-thumb">
                        @if (!user.Avatar.IsNullOrEmpty())
                        {
                            <img src="@user.GetAvatarUrl()" />
                        }
                        else
                        {
                            <i class="fa fa-user"></i>
                        }
                    </span>
                    <span class="upload-box">
                        <span class="btn btn-sm btn-default btn-file">
                            <i class="fa fa-upload"></i> @L.T("Choose file")
                            <input type="file" name="Avatar" accept="image/*" />
                        </span>
                        <span class="help-text">@user.Avatar</span>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- 登录信息 -->
    <div class="form-section">
        <div class="form-section-title"><i class="fa fa-clock-o"></i>@L.T("Sign-in information")</div>
        <div class="form-section-body">
            <div class="form-group">
                <label class="control-label col-sm-4">@L.T("Sign-in count")</label>
                <div class="col-sm-8">
                    <p class="form-value"><i class="fa fa-sign-in"></i>@user.Logins</p>
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-sm-4">@L.T("Last sign-in")</label>
                <div class="col-sm-8">
                    <p class="form-value"><i class="fa fa-calendar-o"></i>@user.LastLogin.ToFullString("")</p>
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-sm-4">@L.T("Last sign-in IP")</label>
                <div class="col-sm-8">
                    <p class="form-value"><i class="fa fa-globe"></i>@user.LastLoginIP</p>
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-sm-4">@L.T("Remark")</label>
                <div class="col-sm-8">
                    @{
                        // 备注在用户实体上配置了 ItemType=html，与编辑页保持一致使用 HTML 富文本编辑器。
                        // 注意：本页 ViewBag.Fields 是基类 OnActionExecuting 注入的列表字段（已移除 Remark），必须从实体元数据判定
                        var remarkField = fact.Table.FindByName("Remark");
                        var remarkItemType = remarkField?.Field?.ItemType ?? remarkField?.Column?.ItemType;
                    }
                    @if (remarkItemType.EqualIgnoreCase("html"))
                    {
                        @await Html.PartialAsync("_HtmlEditor", new ItemModel("Remark", user.Remark, typeof(String)))
                    }
                    else
                    {
                        @Html.ForEditor("Remark")
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- 操作栏 -->
    <div class="profile-actions">
        <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> @L.T("Save")</button>
        <button type="button" class="btn btn-default" onclick="history.go(-1);"><i class="fa fa-times"></i> @L.T("Cancel")</button>
    </div>
}
</div>