@model LoginViewModel
@using NewLife.Common
@{
    var set = Model;

    var challengeDic = ViewData["ChallengeKey"] == null ? new KeyValuePair<string, string>() : (KeyValuePair<String, String>)ViewData["ChallengeKey"];
    var key = challengeDic.Key;
    var value = challengeDic.Value;
}
<div class="tab-pane fade in active" id="Login">
    @Html.ValidationSummary()

    <!-- 密码登录（RSA 加密） -->
    @if (set.AllowLogin)
    {
        <form action="@Url.Action("Login", "User", new { r = set.ReturnUrl })" class="cube-login" method="post" id="login-pwd" novalidate>
            <input type="hidden" name="category" value="Password" />
            <input id="challenge_id_container" style="display:none;" value="@value" />
            <div class="form-group">
                <div class="input-icon">
                    <i class="fa fa-user-o"></i>
                    <input type="text" class="form-control" id="username" name="username" placeholder="@L.T("User name / email / mobile / code")" autocomplete="username">
                </div>
            </div>
            <div class="form-group">
                <div class="input-icon">
                    <i class="fa fa-lock"></i>
                    <input type="password" class="form-control has-toggle" id="password" placeholder="@L.T("Password")" autocomplete="off">
                    <span class="pwd-toggle" data-target="password" title="@L.T("Show/hide password")"><i class="fa fa-eye"></i></span>
                </div>
            </div>
            <div class="form-options">
                <label class="checkbox-custom">
                    <input type="checkbox" id="remember" name="remember" value="true" checked="checked" />
                    <span class="box"></span>@L.T("Remember me")
                </label>
            </div>
            <input name="challengeId" value="@key" style="display:none;" />
            <input type="text" name="pubKey" style="display:none" />
            <input id="pwd" style="display:none" name="password" />
            <button type="button" id="login-btn" class="btn-login">@L.T("Sign in")</button>
        </form>
    }
</div>
