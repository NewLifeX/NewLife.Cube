@model dynamic
@using NewLife;
@using NewLife.Web;
@{
    var d = Model;
}   
<div class="widget-profile">
    <div class="profile-main">
        <div class="profile-avatar"><i class="fa fa-user"></i></div>
        <div class="profile-info">
            <div class="profile-name">@d.DisplayName</div>
            <div class="profile-role">@d.RoleNames</div>
        </div>
    </div>
    <table class="table table-condensed widget-table">
        <tbody>
            <tr>
                <td class="w-name">账号</td>
                <td class="w-value">@d.Name</td>
            </tr>
            <tr>
                <td class="w-name">状态</td>
                <td class="w-value">@(d.Online ? "在线" : "离线")</td>
            </tr>
            <tr>
                <td class="w-name">登录次数</td>
                <td class="w-value">@d.Logins 次</td>
            </tr>
            <tr>
                <td class="w-name">上次登录</td>
                <td class="w-value">@d.LastLogin</td>
            </tr>
            <tr>
                <td class="w-name">上次地址</td>
                <td class="w-value">@d.LastLoginIP</td>
            </tr>
            <tr>
                <td class="w-name">注册时间</td>
                <td class="w-value">@d.RegisterTime</td>
            </tr>
        </tbody>
    </table>
    <div class="widget-more"><a href="/Admin/User/Info" target="_blank">个人中心 »</a></div>
</div>
