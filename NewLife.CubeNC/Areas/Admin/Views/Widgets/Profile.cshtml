@model dynamic
@using NewLife;
@using NewLife.Web;
@{
    var d = Model;
}   
<div class="widget-profile">
    <div class="profile-main">
        <div class="profile-avatar"><i class="fa fa-user"></i></div>
        <div class="profile-info">
            <div class="profile-name">@d.DisplayName</div>
            <div class="profile-role">@d.RoleNames</div>
        </div>
    </div>
    <table class="table table-condensed widget-table">
        <tbody>
            <tr>
                <td class="w-name">@L.T("Account")</td>
                <td class="w-value">@d.Name</td>
            </tr>
            <tr>
                <td class="w-name">@L.T("Status")</td>
                <td class="w-value">@(d.Online ? L.T("Online") : L.T("Offline"))</td>
            </tr>
            <tr>
                <td class="w-name">@L.T("Sign-in count")</td>
                <td class="w-value">@d.Logins @L.T("times")</td>
            </tr>
            <tr>
                <td class="w-name">@L.T("Previous sign-in")</td>
                <td class="w-value">@d.LastLogin</td>
            </tr>
            <tr>
                <td class="w-name">@L.T("Previous address")</td>
                <td class="w-value">@d.LastLoginIP</td>
            </tr>
            <tr>
                <td class="w-name">@L.T("Registration time")</td>
                <td class="w-value">@d.RegisterTime</td>
            </tr>
        </tbody>
    </table>
    <div class="widget-more"><a href="/Admin/User/Info" target="_blank">@L.T("Profile »")</a></div>
</div>
