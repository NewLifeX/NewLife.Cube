@model NewLife.Cube.Charts.ECharts
@using NewLife.Cube.Charts
@{
    var chart = Model;
}
@await Html.PartialAsync("_ECharts", chart)
<script>
    $(function () {
        var chart = chart_Monitor;
        if (!chart) return;

        // 定时轮询监控数据，追加到曲线（保留最近60个点）
        setInterval(function () {
            $.get('@Url.Action("MonitorData")', function (data) {
                if (!data || data.time == null) return;

                var opt = chart.getOption();
                var xs = (opt.xAxis && opt.xAxis[0] && opt.xAxis[0].data) || [];
                xs.push(data.time);
                if (xs.length > 60) xs.shift();

                var cpu = (opt.series && opt.series[0] && opt.series[0].data) || [];
                cpu.push(data.cpu);
                if (cpu.length > 60) cpu.shift();

                var mem = (opt.series && opt.series[1] && opt.series[1].data) || [];
                mem.push(data.memUsed);
                if (mem.length > 60) mem.shift();

                chart.setOption({ xAxis: { data: xs }, series: [{ data: cpu }, { data: mem }] });
            });
        }, 5000);
    });
</script>
