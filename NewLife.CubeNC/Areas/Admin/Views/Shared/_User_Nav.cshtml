@{
    var path = Context.Request.Path + "";

    var user = ManageProvider.User;
    var currentId = user?.ID ?? 0;
    var userId = Context.Request.Query["userId"].ToInt(0);
    if (userId == 0 && path.StartsWithIgnoreCase("/Admin/User/Detail", "/Admin/User/Edit"))
    {
        userId = Context.Request.Query["Id"].ToInt(0);
        // 路由形式 /Admin/User/Edit/{id}，主键在路由值而不是查询参数
        if (userId == 0) userId = (ViewContext.RouteData.Values["id"] + "").ToInt();
    }
    if (userId == 0) userId = currentId;

    // 非系统角色只能查看本人：与列表页 [DataPermission] 口径一致，禁止经 ?userId= 深链窥探他人
    if (user == null || !user.Roles.Any(e => e.IsSystem)) userId = currentId;

    // 该用户
    user = XCode.Membership.User.FindByID(userId);

    var dic = new Dictionary<String, Object>();
    if (userId == currentId)
    {
        dic["Basic info"] = "/Admin/User/Info";
        dic["Change password"] = "/Admin/User/ChangePassword";
        dic["Third-party authorization"] = "/Admin/User/Binds";
        dic["Tenant info"] = "/Admin/User/TenantSetting";
    }
    // 用户页对非系统角色只读（资料编辑走用户中心），此处统一指向只读查看页
    dic[user + ""] = $"/Admin/User/Detail?Id={userId}";
    dic["Linked accounts"] = $"/Admin/UserConnect?userId={userId}";
    dic["Tokens"] = $"/Admin/UserToken?userId={userId}";
    dic["OAuth log"] = $"/Admin/OAuthLog?userId={userId}";
    dic["Logs"] = $"/Admin/Log?userId={userId}";
    dic["Notification records"] = $"/Admin/NotificationRecord?userId={userId}&channel=InApp";

    // Tab 图标
    var icons = new Dictionary<String, String>
    {
        ["Basic info"] = "fa-user",
        ["Change password"] = "fa-key",
        ["Third-party authorization"] = "fa-plug",
        ["Tenant info"] = "fa-building-o",
        ["Linked accounts"] = "fa-link",
        ["Tokens"] = "fa-ticket",
        ["OAuth log"] = "fa-history",
        ["Logs"] = "fa-list-alt",
        ["Notification records"] = "fa-bell-o",
    };
    // 用户标签为查看页
    icons[user + ""] = "fa-eye";
}
@* 用户中心页面专用样式：仅在此 partial 渲染的页面加载，避免污染全局 Cube.css *@
<link rel="stylesheet" href="~/Content/profile.css?v=20260826" />
<div class="profile-tabs">
    <ul class="nav nav-tabs" role="tablist">
        @foreach (var item in dic)
        {
            var url = item.Value + "";
            var p = url.IndexOf('?');
            var v = p > 0 ? url.Substring(0, p) : url;
            var icon = icons.ContainsKey(item.Key) ? icons[item.Key] : "fa-pencil-square-o";
            // 用户标签指向查看页；用户编辑页（管理入口）同样点亮该标签
            var active = path.EqualIgnoreCase(v) || (v.EqualIgnoreCase("/Admin/User/Detail") && path.StartsWithIgnoreCase("/Admin/User/Edit"));
            <li role="presentation" class="@(active ? "active" : "")">
                <a href="@url"><i class="fa @icon"></i>@L.T(item.Key)</a>
            </li>
        }
    </ul>
</div>