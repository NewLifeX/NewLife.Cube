@{
    var obj = Model as Object;
    var path = Context.Request.Path + "";

    // 设置页之间切换时保留当前语言参数，避免丢失 lang=xx 后回落到默认语言
    var lang = Context.Request.Query["lang"].ToString();
    String WithLang(String url) => lang.IsNullOrEmpty() ? url : url + (url.Contains('?') ? "&" : "?") + "lang=" + Uri.EscapeDataString(lang);

    var dic = new Dictionary<String, Object>();
    dic[L.T("Basic settings")] = WithLang("/Admin/Core");
    dic[L.T("System settings")] = WithLang("/Admin/Sys");
    dic[L.T("Stardust settings")] = WithLang("/Admin/Star");
    dic[L.T("Data middleware")] = WithLang("/Admin/XCode");
    dic[L.T("Cube settings")] = WithLang("/Admin/Cube");

    {
        var dic2 = new Dictionary<String, Object>();
        dic[L.T("More settings")] = dic2;

        dic2[L.T("SMS settings")] = WithLang("/Admin/SmsConfig?nav=1");
        dic2[L.T("Email settings")] = WithLang("/Admin/MailConfig?nav=1");
        dic2[L.T("OAuth settings")] = WithLang("/Admin/OAuthConfig?nav=1");
        dic2[L.T("Access rules")] = WithLang("/Admin/AccessRule?nav=1");
    }
}
<div class="navbar-collapse text-center">
    <ul class="nav nav-pills" style="margin-bottom: 10px; display: inline-block;float: none;">
        @foreach (var item in dic)
        {
            if (item.Value is IDictionary<String, Object> childs)
            {
                <li role="presentation" class="dropdown">
                    <a class="dropdown-toggle" data-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">@item.Key <span class="caret"></span></a>
                    <ul class="dropdown-menu">
                        @foreach (var elm in childs)
                        {
                            var url = elm.Value + "";
                            var p = url.IndexOf('?');
                            var v = p > 0 ? url.Substring(0, p) : url;
                            <li role="presentation" class="@(path.EqualIgnoreCase(v) ? "active" : "")"><a href="@url">@elm.Key</a></li>
                        }
                    </ul>
                </li>
            }
            else
            {
                var url = item.Value + "";
                var p = url.IndexOf('?');
                var v = p > 0 ? url.Substring(0, p) : url;
                <li role="presentation" class="@(path.EqualIgnoreCase(v) ? "active" : "")"><a href="@url">@item.Key</a></li>
            }
        }
    </ul>
</div>