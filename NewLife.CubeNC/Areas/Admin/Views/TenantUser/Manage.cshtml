@model IEnumerable<TenantUser>
@using NewLife;
@using NewLife.Cube.ViewModels;
@using NewLife.Web;
@using XCode;
@using XCode.Membership;
@{
    var tenant = ViewBag.Tenant as Tenant;
    var tid = (Int32)(ViewBag.TenantId ?? 0);

    // 租户可用角色（租户未配置角色时展示全部角色）
    var tenantRoleIds = new Int32[0];
    if (tenant != null && !tenant.RoleIds.IsNullOrEmpty()) tenantRoleIds = tenant.RoleIds.SplitAsInt(",");
    var roles = Role.FindAllWithCache()
        .Where(e => tenantRoleIds.Length == 0 || tenantRoleIds.Contains(e.ID))
        .OrderByDescending(e => e.Sort)
        .ToList();

    ViewBag.Title = String.Format(L.T("Member management of tenant [{0}]"), tenant?.Name);
}
<div class="page-header">
    <h3><i class="fa fa-users"></i> @String.Format(L.T("Member management of tenant [{0}]"), tenant?.Name)
        <small>@(tenant?.Code)</small>
        <span class="pull-right">
            <a class="btn btn-sm btn-default" href="/Admin/Tenant"><i class="fa fa-list"></i> @L.T("Back to tenant")</a>
            <a class="btn btn-sm btn-default" href="/Admin/TenantUser?tenantId=@tid"><i class="fa fa-table"></i> @L.T("Standard list")</a>
        </span>
    </h3>
</div>

@if (tid > 0)
{
    <div class="well well-sm">
        <form id="addMemberForm" class="form-inline" onsubmit="return false;">
            <input type="hidden" name="tenantId" value="@tid" />
            <div class="form-group" style="min-width:320px;vertical-align:top;">
                @await Html.PartialAsync("_SelectUser", new SelectUserModel { Id = "userId", UserId = 0 })
            </div>
            <div class="form-group">
                <select id="roleIds" name="roleIds" class="form-control" multiple="multiple" style="min-width:180px;height:38px;" title="@L.T("Multiple roles allowed")">
                    @foreach (var role in roles)
                    {
                        <option value="@role.ID">@role.Name</option>
                    }
                </select>
            </div>
            <button type="button" class="btn btn-success" onclick="addMember()"><i class="fa fa-plus"></i> @L.T("Add member")</button>
            <span class="help-block">@L.T("Search a user to add to the current tenant and assign roles at the same time")</span>
        </form>
    </div>
}

<table class="table table-bordered table-hover table-striped table-condensed">
    <thead>
        <tr>
            <th>@L.T("User")</th>
            <th>@L.T("Role")</th>
            <th>@L.T("Status")</th>
            <th>@L.T("Join time")</th>
            <th>@L.T("Operation")</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var tu in Model)
        {
            var user = XCode.Membership.User.FindByID(tu.UserId);
            <tr>
                <td>@(user?.ToString())</td>
                <td>@tu.RoleNames</td>
                <td>
                    @if (tu.Enable)
                    {
                        <span class="label label-success">@L.T("Normal")</span>
                    }
                    else
                    {
                        <span class="label label-default">@L.T("Disabled")</span>
                    }
                </td>
                <td>@tu.CreateTime.ToFullString()</td>
                <td>
                    @if (tenant == null || tenant.ManagerId != tu.UserId)
                    {
                        <button type="button" class="btn btn-xs btn-warning" onclick="toggleMember(@tu.Id, @(!tu.Enable))">@(tu.Enable ? L.T("Disabled") : L.T("Enabled"))</button>
                        <button type="button" class="btn btn-xs btn-danger" onclick="removeMember(@tu.Id)">@L.T("Remove")</button>
                    }
                    else
                    {
                        <span class="text-muted">@L.T("Tenant administrator")</span>
                    }
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5" class="text-center text-muted">@L.T("No members yet; search a user below to add")</td>
            </tr>
        }
    </tbody>
</table>

<script type="text/javascript">
    function addMember() {
        var userId = $('#userId').val();
        if (!userId) { alert('@L.T("Search and select a user first")'); return; }
        $.ajax({
            url: '/Admin/TenantUser/AddMember',
            type: 'POST',
            data: $('#addMemberForm').serialize(),
            dataType: 'json',
            success: function (json) {
                if (json && json.code === 0) {
                    location.reload();
                } else {
                    alert((json && json.message) || '@L.T("Add failed")');
                }
            },
            error: function (xhr) {
                alert('@L.T("Request failed:")' + ' ' + (xhr.statusText || ''));
            }
        });
    }

    function toggleMember(id, enable) {
        $.ajax({
            url: '/Admin/TenantUser/ToggleMember',
            type: 'POST',
            data: { id: id, enable: enable },
            dataType: 'json',
            success: function (json) {
                if (json && json.code === 0) {
                    location.reload();
                } else {
                    alert((json && json.message) || '@L.T("Operation failed")');
                }
            },
            error: function (xhr) {
                alert('@L.T("Request failed:")' + ' ' + (xhr.statusText || ''));
            }
        });
    }

    function removeMember(id) {
        if (!confirm('@L.T("Remove this member?")')) return;
        $.ajax({
            url: '/Admin/TenantUser/RemoveMember',
            type: 'POST',
            data: { id: id },
            dataType: 'json',
            success: function (json) {
                if (json && json.code === 0) {
                    location.reload();
                } else {
                    alert((json && json.message) || '@L.T("Operation failed")');
                }
            },
            error: function (xhr) {
                alert('@L.T("Request failed:")' + ' ' + (xhr.statusText || ''));
            }
        });
    }
</script>
