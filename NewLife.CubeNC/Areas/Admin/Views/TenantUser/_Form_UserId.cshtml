@model EntityField
@using NewLife;
@using NewLife.Cube.ViewModels;
@using XCode;
@using XCode.Configuration;
@using XCode.Membership;
@{
    var entity = Model.Entity as TenantUser;
    var field = Model.Field;

    var set = NewLife.Cube.CubeSetting.Current;
    var cls = set.FormGroupClass;
    if (cls.IsNullOrEmpty()) { cls = "form-group col-xs-12 col-sm-6 col-lg-4"; }
}
<div class="@cls">
    <label class="control-label col-xs-3 col-sm-3">用户</label>
    <div class="input-group col-xs-9 col-sm-5">
        @await Html.PartialAsync("_SelectUser", new SelectUserModel { Id = "UserId", UserId = entity?.UserId ?? 0 })
    </div>
    <span class="hidden-xs col-sm-4">搜索用户，按编码/名称/昵称/手机号</span>
</div>
