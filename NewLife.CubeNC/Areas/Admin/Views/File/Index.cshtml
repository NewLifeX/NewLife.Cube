@using System.Diagnostics;
@using NewLife.Common;
@using NewLife.Cube.Areas.Admin;
@{
    var fs = Model as List<FileItem>;
    var r = ViewBag.Current as String;
    var clips = ViewBag.Clip as ICollection<FileItem>;
}
<div class="form-inline">
    <form action="~/Admin/File" id="tool" method="post">
        <div class="input-group">
            <span class="input-group-addon">
                <i class="ace-icon fa fa-check"></i>
            </span>
            <input name="r" type="search" id="r" value="@r" class="form-control" placeholder="@L.T("Current path")" />
            <span class="input-group-btn">
                <button type="submit" class="btn btn-primary btn-sm">
                    <span class="glyphicon glyphicon-folder-open icon-on-right bigger-110"></span>
                    @L.T("Open")
                </button>
            </span>
        </div>
        <div class="input-group">
            <span class="input-group-addon">
                <i class="glyphicon glyphicon-file"></i>
            </span>
            <input name="file" type="file" id="file" placeholder="@L.T("Upload file")" data-action="upload" data-url="/Admin/File/Upload" data-fields="r" />
        </div>
        @if (clips.Count > 0)
        {
            <div class="input-group">
                <span class="input-group-addon">
                    <i class="glyphicon glyphicon-floppy-disk" title="@String.Format(L.T("{0} items in clipboard"), clips.Count)">@clips.Count</i>
                </span>
                <span class="input-group-btn">
                    <button type="button" class="btn btn-pink btn-sm" onclick="location.href = '/Admin/File/Paste?r=@r';">
                        <span class="glyphicon glyphicon-floppy-save icon-on-right bigger-110"></span>
                        @L.T("Paste")
                    </button>
                </span>
                <span class="input-group-btn">
                    <button type="button" class="btn btn-gray btn-sm" onclick="location.href = '/Admin/File/Move?r=@r';">
                        <span class="glyphicon glyphicon-floppy-save icon-on-right bigger-110"></span>
                        @L.T("Move")
                    </button>
                </span>
                <span class="input-group-btn">
                    <button type="button" class="btn btn-yellow btn-sm" onclick="location.href = '/Admin/File/ClearClipboard?r=@r';">
                        <span class="glyphicon glyphicon-retweet icon-on-right bigger-110"></span>
                        @L.T("Clear")
                    </button>
                </span>
            </div>
        }
    </form>
</div>
<table class="table table-bordered table-hover table-striped table-condensed">
    <thead>
        <tr>
            <th class="text-center"><a href="~/Admin/File?r=@r&sort=name">@L.T("Name")</a></th>
            <th class="text-center"><a href="~/Admin/File?r=@r&sort=size">@L.T("Size")</a></th>
            <th class="text-center"><a href="~/Admin/File?r=@r&sort=lastwrite">@L.T("Modify time")</a></th>
            <th class="text-center">@L.T("Copy")</th>
            <th class="text-center">@L.T("Compress")</th>
            <th class="text-center">@L.T("Delete")</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in fs)
        {
            <tr>
                @if (item.LastWrite.Year > 2000)
                {
                    if (item.Directory)
                    {
                        <td>&nbsp;&nbsp;<a href="~/Admin/File?r=@item.FullName" title="@L.T("Enter directory")">@item.Name</a></td>
                    }
                    else
                    {
                        <td>&nbsp;&nbsp;<a href="~/Admin/File/Download?r=@item.FullName" title="@L.T("Download file")">@item.Name</a></td>
                    }
                    <td class="text-right">@item.Size</td>
                    <td class="text-center">@item.LastWrite.ToFullString("")</td>
                    <td class="text-center">
                        @if (!clips.Any(e => e.FullName == item.FullName))
                        {
                            <a href="~/Admin/File/Copy?r=@r&f=@item.FullName" title="@L.T("Copy to clipboard, then paste in the target directory")">@L.T("Copy")</a>
                        }
                        else
                        {
                            <a href="~/Admin/File/CancelCopy?r=@r&f=@item.FullName" title="@L.T("Remove from clipboard")">@L.T("Cancel copy")</a>
                        }
                    </td>
                    @if (item.Name.EndsWithIgnoreCase(".zip"))
                    {
                        <td class="text-center"><a href="~/Admin/File/Decompress?r=@item.FullName" title="@L.T("Extract to current directory")">@L.T("Extract")</a></td>
                    }
                    else
                    {
                        <td class="text-center"><a href="~/Admin/File/Compress?r=@item.FullName" title="@L.T("Compress to current directory with a time suffix")">@L.T("Compress")</a></td>
                    }
                    <td class="text-center"><a href="~/Admin/File/Delete?r=@item.FullName" onclick="return confirm('@L.T("Confirm delete?")');">@L.T("Delete")</a></td>
                }
                else
                {
                    if (item.Directory)
                    {
                        <td>&nbsp;&nbsp;<a href="~/Admin/File?r=@item.FullName" title="@L.T("Enter directory")">@item.Name</a></td>
                    }
                    else
                    {
                        <td>&nbsp;&nbsp;@item.Name</td>
                    }
                    <td class="text-right">@item.Size</td>
                    <td class="text-center">@item.LastWrite.ToFullString("")</td>
                    <td></td>
                    <td></td>
                    <td></td>
                }
            </tr>
        }
    </tbody>
</table>