@using NewLife.Cube.Extensions
@{
    var fact = ViewBag.Factory as IEntityFactory;
    var page = ViewBag.Page as Pager;

    var dic = new Dictionary<Int32, String>();
    dic.Add(1, L.T("Succeeded"));
    dic.Add(0, L.T("Failed"));
}
<div class="form-group">
    @*@Html.ActionLink("访问统计", "Index", "VisitStat", null, new { @class = "btn btn-success btn-sm" })*@
    <label for="category" class="control-label">@L.T("Category:")</label>
    @Html.ForDropDownList("category", Log.FindAllCategoryName(), page["category"], L.T("All"), true)
</div>
<div class="form-group">
    <label for="act" class="control-label">@L.T("Operations:")</label>
    @Html.ForDropDownList("act", Log.FindAllActionName(), page["act"], L.T("All"), true)
</div>
@await Html.PartialAsync("_Enable", "success")
@await Html.PartialAsync("_SelectUser", new SelectUserModel { Id = "userId", UserId = page["userId"].ToInt(-1) })
@await Html.PartialAsync("_DateRange")