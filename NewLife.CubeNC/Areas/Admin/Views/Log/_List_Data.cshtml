@model IList<XCode.Membership.Log>
@using NewLife;
@using NewLife.Web;
@using XCode;
@using XCode.Configuration;
@{
    var fact = ViewBag.Factory as IEntityFactory;
    var page = ViewBag.Page as Pager;
    var set = ViewBag.PageSetting as PageSetting ?? PageSetting.Global;
    var today = DateTime.Today.ToString("yyyy-MM-dd ");
}
<table class="table table-bordered table-hover table-striped table-condensed">
    <thead>
        <tr>
            @if (set.EnableSelect)
            {
                <th class="text-center" style="width:10px;"><input type="checkbox" id="chkAll" title="@L.T("Select all")" /></th>
            }
            <th class="text-center"><a href="@Html.Raw(page.GetSortUrl("Category"))">@L.T("Category")</a></th>
            <th class="text-center"><a href="@Html.Raw(page.GetSortUrl("Action"))">@L.T("Operation")</a></th>
            <th class="text-center"><a href="@Html.Raw(page.GetSortUrl("Success"))">@L.T("Succeeded")</a></th>
            <th class="text-center"><a href="@Html.Raw(page.GetSortUrl("Remark"))">@L.T("Details")</a></th>
            <th class="text-center" title="@L.T("Trace id. Records the call chain trace id for locating the chain in APM")"><a href="@Html.Raw(page.GetSortUrl("TraceId"))">@L.T("Trace")</a></th>
            <th class="text-center"><a href="@Html.Raw(page.GetSortUrl("LinkID"))">@L.T("Association")</a></th>
            <th class="text-center"><a href="@Html.Raw(page.GetSortUrl("UserName"))">@L.T("User name")</a></th>
            <th class="text-center"><a href="@Html.Raw(page.GetSortUrl("CreateIP"))">@L.T("IP address")</a></th>
            <th class="text-center"><a href="@Html.Raw(page.GetSortUrl("CreateAddress"))">@L.T("Physical address")</a></th>
            <th class="text-center"><a href="@Html.Raw(page.GetSortUrl("CreateTime"))">@L.T("Time")</a></th>
            <th class="text-center">@L.T("Nearby")</th>
            @if (this.Has(PermissionFlags.Detail))
            {
                <th class="text-center">@L.T("Operation")</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var entity in Model)
        {
            <tr>
                @if (set.EnableSelect)
                {
                    <td class="text-center"><input type="checkbox" name="keys" value="@entity.ID" /></td>
                }
                <td class="text-center">@entity.Category</td>
                <td class="text-center">@entity.Action</td>
                <td class="text-center">
                    @await Html.PartialAsync("_Icon_Boolean", entity.Success)
                </td>
                <td style="max-width:600px;overflow:hidden;white-space: nowrap;text-overflow: ellipsis;" title="@entity.Remark">@entity.Remark</td>
                <td class="text-center">
                    @if (!entity.TraceId.IsNullOrEmpty())
                    {
                        <a href="@StarHelper.BuildUrl(entity.TraceId)" title="@L.T("Distributed tracing for APM; restores the call chain of this event")" target="_blank">@L.T("Trace")</a>
                    }
                </td>
                <td class="text-right">@entity.LinkID.ToString("n0")</td>
                <td>@entity.UserName</td>
                <td>@entity.CreateIP</td>
                <td>@entity.CreateIP.IPToAddress()</td>
                <td class="text-center" style="max-width:150px">@entity.CreateTime.ToFullString("").TrimPrefix(today)</td>
                <td class="text-center">
                    <a href="?act=near&id=@entity.ID&range=10" title="@L.T("10 lines before and after")">@L.T("Nearby")</a>
                </td>
                @if (this.Has(PermissionFlags.Detail))
                {
                    <td class="text-center" style="width: 90px;">
                        @await Html.PartialAsync("_List_Data_Action", (Object)entity)
                    </td>
                }
            </tr>
        }
    </tbody>
</table>