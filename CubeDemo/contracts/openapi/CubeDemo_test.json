    "/api/Test/TestField/ImportFile": {
      "post": {
        "tags": [
          "TestField"
        ],
        "summary": "导入文件（Excel/Csv/Json/Zip），然后批量写入数据库。经类级路由 api/[area]/[controller]/[action] 暴露为 POST /api/{area}/{controller}/ImportFile",
        "description": "依据文件扩展名分发到 ImportExcel/ImportCsv/ImportJson/ImportZip；导入失败时返回 code!=0 的业务错误",
        "requestBody": {
          "description": "上传的 Excel/Csv/Json/Zip 文件",
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "$ref": "#/components/schemas/IFormFile"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "统一 Json 响应，message 含导入行数",
            "content": {
              "application/json": { }
            }
          }
        }
      }
    },
    "/api/Test/TestField/UploadFile": {
      "post": {
        "tags": [
          "TestField"
        ],
        "summary": "上传编辑器文件，关联当前实体",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "实体主键。大于零时关联已有实体；为零时属新增场景，以临时实体归类路径，表单保存后通过 attachmentIds 绑定主记录",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "title",
            "in": "query",
            "description": "附件标题（主记录显示名）。为空时使用 entity.ToString()；新增场景下主记录尚未保存，可传入预期标题",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "上传文件",
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "$ref": "#/components/schemas/IFormFile"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "附件编号、文件路径、MIME 类型",
            "content": {
              "application/json": { }
            }
          }
        }
      }
    },
    "/api/Test/TestField/{id}": {
      "get": {
        "tags": [
          "TestField"
        ],
        "summary": "查看单行数据",
        "description": "同时支持两种风格：\r\n1) RESTful：`/api/[area]/[controller]/{id}`，如 /api/Admin/User/21；\r\n2) 传统 Action+查询参数：`/api/[area]/[controller]/Detail?id=`，类级 Route 已生成该字面量路由。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "主键。可能为空（表示添加），所以用字符串而不是整数",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOf测试字段"
                }
              }
            }
          }
        }
      }
    },
    "/api/Test/TestField/Detail": {
      "get": {
        "tags": [
          "TestField"
        ],
        "summary": "查看单行数据",
        "description": "同时支持两种风格：\r\n1) RESTful：`/api/[area]/[controller]/{id}`，如 /api/Admin/User/21；\r\n2) 传统 Action+查询参数：`/api/[area]/[controller]/Detail?id=`，类级 Route 已生成该字面量路由。",
