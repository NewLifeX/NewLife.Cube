      "get": {
        "tags": [
          "TestField"
        ],
        "summary": "获取字段信息。支持用户重载并根据上下文定制界面",
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "description": "字段类型：1-列表List、2-详情Detail、3-添加AddForm、4-编辑EditForm、5-搜索Search",
