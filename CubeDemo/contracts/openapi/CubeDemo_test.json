    "/api/Test/TestField/DeleteSelect": {
      "delete": {
        "tags": [
          "TestField"
        ],
        "summary": "批量删除选中数据。前端 deleteSelect 调用，支持重复参数 id=1&amp;id=2、索引形式 id[0]=1&amp;id[1]=2、逗号分隔 id=1,2",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "主键集合。为空时返回参数错误",
            "schema": {
              "type": "array",
