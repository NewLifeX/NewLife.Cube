      "get": {
        "tags": [
          "TestField"
        ],
        "summary": "统一导出接口。根据 format 参数分发到不同格式的导出逻辑",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "description": "导出格式，支持 excel/csv/json/xml，默认 excel",
            "schema": {
              "type": "string",
              "default": "excel"
